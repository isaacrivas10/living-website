{"node": "domo", "prompt": "Build a sales funnel dashboard with conversion KPIs and a stage breakdown.", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Argo Analytics - Sales Funnel Dashboard</title>\n    <style>\n        :root {\n            --bg-color: #0b0f14;\n            --card-bg: rgba(255, 255, 255, 0.04);\n            --card-border: rgba(255, 255, 255, 0.08);\n            --text-primary: #e6edf3;\n            --text-muted: #9ba7b4;\n            --accent-green: #2fbf71;\n            --accent-yellow: #f2c94c;\n            --accent-teal: #21a8a0;\n            --grid-line: rgba(255, 255, 255, 0.06);\n            --axis-line: rgba(255, 255, 255, 0.15);\n            --font-main: system-ui, -apple-system, sans-serif;\n        }\n\n        html, body {\n            margin: 0;\n            padding: 0;\n            background: var(--bg-color);\n            color: var(--text-primary);\n            font-family: var(--font-main);\n            height: 100%;\n            overflow: hidden;\n        }\n\n        .dashboard-container {\n            display: flex;\n            flex-direction: column;\n            height: 100vh;\n            padding: 20px;\n            box-sizing: border-box;\n        }\n\n        header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding-bottom: 20px;\n            border-bottom: 1px solid var(--card-border);\n            margin-bottom: 20px;\n        }\n\n        h1 {\n            font-size: 24px;\n            font-weight: 600;\n            margin: 0;\n            letter-spacing: 0.5px;\n        }\n\n        .subtitle {\n            color: var(--text-muted);\n            font-size: 14px;\n        }\n\n        .date-picker {\n            display: flex;\n            gap: 10px;\n            align-items: center;\n        }\n\n        select {\n            background: var(--card-bg);\n            border: 1px solid var(--card-border);\n            color: var(--text-primary);\n            padding: 8px 12px;\n            border-radius: 6px;\n            font-size: 14px;\n            cursor: pointer;\n            outline: none;\n        }\n\n        button {\n            background: var(--accent-green);\n            border: none;\n            color: #000;\n            padding: 8px 16px;\n            border-radius: 6px;\n            font-weight: 600;\n            cursor: pointer;\n            transition: opacity 0.2s;\n        }\n\n        button:hover {\n            opacity: 0.9;\n        }\n\n        .grid-layout {\n            display: grid;\n            grid-template-columns: 2fr 1fr;\n            grid-template-rows: 1fr 1fr;\n            gap: 20px;\n            flex-grow: 1;\n            height: 100%;\n        }\n\n        .card {\n            background: var(--card-bg);\n            border: 1px solid var(--card-border);\n            border-radius: 10px;\n            padding: 20px;\n            display: flex;\n            flex-direction: column;\n            box-shadow: 0 4px 24px rgba(0,0,0,0.4);\n            overflow: hidden;\n        }\n\n        .card-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 20px;\n        }\n\n        .card-title {\n            font-size: 16px;\n            font-weight: 500;\n            color: var(--text-primary);\n        }\n\n        .card-icon {\n            width: 8px;\n            height: 8px;\n            border-radius: 50%;\n            background: var(--accent-green);\n            box-shadow: 0 0 8px var(--accent-green);\n        }\n\n        .kpi-tile {\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n        }\n\n        .kpi-value {\n            font-size: 48px;\n            font-weight: 700;\n            line-height: 1;\n            margin-bottom: 5px;\n            color: var(--text-primary);\n        }\n\n        .kpi-label {\n            font-size: 14px;\n            color: var(--text-muted);\n            text-transform: uppercase;\n            letter-spacing: 1px;\n        }\n\n        .kpi-trend {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            margin-top: 10px;\n            font-size: 14px;\n        }\n\n        .trend-up {\n            color: var(--accent-green);\n        }\n\n        .trend-down {\n            color: var(--accent-yellow);\n        }\n\n        .chart-container {\n            flex-grow: 1;\n            position: relative;\n            width: 100%;\n            min-height: 200px;\n        }\n\n        svg {\n            width: 100%;\n            height: 100%;\n            display: block;\n        }\n\n        .funnel-group {\n            cursor: pointer;\n            transition: opacity 0.2s;\n        }\n\n        .funnel-group:hover {\n            opacity: 0.9;\n        }\n\n        .funnel-bar {\n            fill: var(--accent-teal);\n            stroke: rgba(0,0,0,0.2);\n            transition: fill 0.3s;\n        }\n\n        .funnel-group:hover .funnel-bar {\n            fill: var(--accent-green);\n        }\n\n        .funnel-text {\n            fill: var(--text-primary);\n            font-size: 14px;\n            font-weight: 600;\n            text-anchor: end;\n            alignment-baseline: middle;\n        }\n\n        .funnel-percent {\n            fill: var(--text-muted);\n            font-size: 12px;\n            text-anchor: start;\n        }\n\n        .bar-group {\n            cursor: pointer;\n        }\n\n        .bar {\n            fill: var(--accent-green);\n            transition: fill 0.3s;\n        }\n\n        .bar:hover {\n            fill: var(--accent-teal);\n        }\n\n        .bar-label {\n            fill: var(--text-primary);\n            font-size: 12px;\n            text-anchor: middle;\n            margin-top: 5px;\n        }\n\n        .axis-text {\n            fill: var(--text-muted);\n            font-size: 12px;\n        }\n\n        .grid-line {\n            stroke: var(--grid-line);\n            stroke-width: 1;\n        }\n\n        .axis-line {\n            stroke: var(--axis-line);\n            stroke-width: 1.5;\n        }\n\n        @media (max-width: 900px) {\n            .grid-layout {\n                grid-template-columns: 1fr;\n                grid-template-rows: auto auto auto;\n                overflow-y: auto;\n            }\n            .kpi-value {\n                font-size: 36px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"dashboard-container\">\n        <header>\n            <div>\n                <h1>Sales Funnel Overview</h1>\n                <div class=\"subtitle\">Argo Analytics \u2022 Q3 Performance \u2022 Last 30 Days</div>\n            </div>\n            <div class=\"date-picker\">\n                <select id=\"timeRange\">\n                    <option>Last 7 Days</option>\n                    <option selected>Last 30 Days</option>\n                    <option>This Quarter</option>\n                    <option>Year to Date</option>\n                </select>\n                <button id=\"exportBtn\">Export Report</button>\n            </div>\n        </header>\n\n        <div class=\"grid-layout\">\n            <div class=\"card kpi-tile\">\n                <div class=\"card-header\">\n                    <span class=\"card-title\">Total Pipeline Value</span>\n                    <div class=\"card-icon\"></div>\n                </div>\n                <div class=\"kpi-value\" id=\"totalRevenue\">$4.2M</div>\n                <div class=\"kpi-label\">Net New Business</div>\n                <div class=\"kpi-trend\">\n                    <span class=\"trend-up\">\u2191 12.5%</span>\n                    <span class=\"kpi-label\" style=\"color: var(--text-muted);\">vs previous period</span>\n                </div>\n            </div>\n\n            <div class=\"card kpi-tile\">\n                <div class=\"card-header\">\n                    <span class=\"card-title\">Overall Conversion</span>\n                    <div class=\"card-icon\" style=\"background: var(--accent-yellow); box-shadow: 0 0 8px var(--accent-yellow);\"></div>\n                </div>\n                <div class=\"kpi-value\" id=\"overallConversion\">24.8%</div>\n                <div class=\"kpi-label\">Lead to Closed Won</div>\n                <div class=\"kpi-trend\">\n                    <span class=\"trend-down\">\u2193 1.2%</span>\n                    <span class=\"kpi-label\" style=\"color: var(--text-muted);\">slight dip in Prospecting</span>\n                </div>\n            </div>\n\n            <div class=\"card\" style=\"grid-column: 1 / -1; min-height: 350px;\">\n                <div class=\"card-header\">\n                    <span class=\"card-title\">Stage-by-Stage Breakdown</span>\n                    <div class=\"card-icon\"></div>\n                </div>\n                <div class=\"chart-container\" id=\"funnelChart\">\n                </div>\n            </div>\n\n            <div class=\"card\">\n                <div class=\"card-header\">\n                    <span class=\"card-title\">Revenue by Sales Rep</span>\n                    <div class=\"card-icon\" style=\"background: var(--accent-teal); box-shadow: 0 0 8px var(--accent-teal);\"></div>\n                </div>\n                <div class=\"chart-container\" id=\"barChart\">\n                </div>\n            </div>\n\n            <div class=\"card\">\n                <div class=\"card-header\">\n                    <span class=\"card-title\">Avg. Deal Velocity</span>\n                    <div class=\"card-icon\"></div>\n                </div>\n                <div class=\"chart-container\" id=\"lineChart\">\n                </div>\n                <div style=\"margin-top: 15px; font-size: 13px; color: var(--text-muted); display: flex; justify-content: space-between;\">\n                    <span>Days to Close</span>\n                    <span style=\"color: var(--accent-green); font-weight: 600;\">24.5 Days</span>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            const funnelData = [\n                { stage: 'Leads', count: 1250, value: 1500000, color: '#9ba7b4' },\n                { stage: 'Qualified', count: 840, value: 1100000, color: '#21a8a0' },\n                { stage: 'Proposal', count: 420, value: 750000, color: '#f2c94c' },\n                { stage: 'Negotiation', count: 185, value: 420000, color: '#e6edf3' },\n                { stage: 'Closed Won', count: 98, value: 420000, color: '#2fbf71' }\n            ];\n\n            const barData = [\n                { name: 'Alex R.', value: 850000, color: '#2fbf71' },\n                { name: 'Sarah K.', value: 720000, color: '#21a8a0' },\n                { name: 'Mike T.', value: 680000, color: '#f2c94c' },\n                { name: 'Jessica L.', value: 540000, color: '#e6edf3' },\n                { name: 'David W.', value: 410000, color: '#9ba7b4' }\n            ];\n\n            const lineData = [\n                { day: 'W1', value: 18 },\n                { day: 'W2', value: 22 },\n                { day: 'W3', value: 24 },\n                { day: 'W4', value: 21 },\n                { day: 'W5', value: 25 },\n                { day: 'W6', value: 28 },\n                { day: 'W7', value: 24 },\n                { day: 'W8', value: 22 }\n            ];\n\n            const formatCurrency = (num) => {\n                return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(num);\n            };\n\n            const formatNumber = (num) => {\n                return new Intl.NumberFormat('en-US').format(num);\n            };\n\n            const renderFunnelChart = () => {\n                const container = document.getElementById('funnelChart');\n                if (!container) return;\n                \n                const width = container.clientWidth || 800;\n                const height = container.clientHeight || 300;\n                \n                const maxVal = funnelData[0].value;\n                const margin = { top: 20, right: 40, bottom: 40, left: 120 };\n                const chartWidth = width - margin.left - margin.right;\n                const chartHeight = height - margin.top - margin.bottom;\n                const stepHeight = chartHeight / funnelData.length;\n                const maxBarWidth = chartWidth;\n\n                let svgContent = `\n                <svg viewBox=\"0 0 ${width} ${height}\" preserveAspectRatio=\"xMidYMid meet\" style=\"width:100%; height:100%; display:block;\">\n                    <defs>\n                        <linearGradient id=\"funnelGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                            <stop offset=\"0%\" style=\"stop-color:#2fbf71;stop-opacity:0.1\" />\n                            <stop offset=\"100%\" style=\"stop-color:#2fbf71;stop-opacity:0.01\" />\n                        </linearGradient>\n                    </defs>\n                    \n                    <g transform=\"translate(${margin.left}, ${margin.top})\">\n                        ${[0, 0.25, 0.5, 0.75, 1].map(y => {\n                            const yPos = chartHeight * y;\n                            return `<line x1=\"0\" y1=\"${yPos}\" x2=\"${chartWidth}\" y2=\"${yPos}\" class=\"grid-line\" />`;\n                        }).join('')}\n\n                        ${funnelData.map((d, i) => {\n                            const widthRatio = d.value / maxVal;\n                            const barWidth = maxBarWidth * widthRatio;\n                            const y = i * stepHeight;\n                            const textY = y + (stepHeight / 2);\n                            const conversion = i === 0 ? 100 : ((d.count / funnelData[i-1].count) * 100).toFixed(1);\n\n                            return `\n                            <g class=\"funnel-group\" data-stage=\"${d.stage}\">\n                                <rect \n                                    x=\"${(maxBarWidth - barWidth) / 2}\" \n                                    y=\"${y + 5}\" \n                                    width=\"${barWidth}\" \n                                    height=\"${stepHeight - 10}\" \n                                    rx=\"4\" \n                                    class=\"funnel-bar\"\n                                    style=\"fill: ${d.color};\"\n                                />\n                                <text x=\"${(maxBarWidth - barWidth) / 2 - 15}\" y=\"${textY}\" class=\"funnel-text\">${formatNumber(d.count)}</text>\n                                <text x=\"${(maxBarWidth + barWidth) / 2 + 15}\" y=\"${textY}\" class=\"funnel-percent\">${conversion}%</text>\n                                <text x=\"0\" y=\"${textY}\" fill=\"var(--text-muted)\" font-size=\"10\" style=\"text-transform: uppercase;\">${d.stage}</text>\n                            </g>`;\n                        }).join('')}\n\n                        <line x1=\"0\" y1=\"${chartHeight}\" x2=\"${chartWidth}\" y2=\"${chartHeight}\" class=\"axis-line\" />\n                    </g>\n                </svg>`;\n\n                container.innerHTML = svgContent;\n            };\n\n            const renderBarChart = () => {\n                const container = document.getElementById('barChart');\n                if (!container) return;\n\n                const width = container.clientWidth || 400;\n                const height = container.clientHeight || 300;\n\n                const margin = { top: 20, right: 20, bottom: 40, left: 60 };\n                const chartWidth = width - margin.left - margin.right;\n                const chartHeight = height - margin.top - margin.bottom;\n                \n                const maxVal = Math.max(...barData.map(d => d.value));\n                const barWidth = (chartWidth / barData.length) * 0.6;\n                const gap = (chartWidth / barData.length);\n\n                let svgContent = `\n                <svg viewBox=\"0 0 ${width} ${height}\" preserveAspectRatio=\"xMidYMid meet\" style=\"width:100%; height:100%; display:block;\">\n                    <g transform=\"translate(${margin.left}, ${margin.top})\">\n                        ${[0, 0.25, 0.5, 0.75, 1].map(level => {\n                            const y = chartHeight - (chartHeight * level);\n                            const valLabel = (maxVal * level).toLocaleString();\n                            return `\n                            <line x1=\"0\" y1=\"${y}\" x2=\"${chartWidth}\" y2=\"${y}\" class=\"grid-line\" />\n                            <text x=\"-10\" y=\"${y + 4}\" text-anchor=\"end\" class=\"axis-text\">$${valLabel.substring(0, valLabel.length - 6)}M</text>\n                            `;\n                        }).join('')}\n\n                        ${barData.map((d, i) => {\n                            const barHeight = (d.value / maxVal) * chartHeight;\n                            const x = i * gap + (gap - barWidth)/2;\n                            const y = chartHeight - barHeight;\n                            return `\n                            <g class=\"bar-group\" data-name=\"${d.name}\">\n                                <rect x=\"${x}\" y=\"${y}\" width=\"${barWidth}\" height=\"${barHeight}\" class=\"bar\" rx=\"3\" style=\"fill: ${d.color};\" />\n                                <text x=\"${x + barWidth/2}\" y=\"${chartHeight + 20}\" text-anchor=\"middle\" class=\"axis-text\" style=\"fill: ${d.color}; font-weight: 600;\">${d.name}</text>\n                                <text x=\"${x + barWidth/2}\" y=\"${y - 5}\" class=\"axis-text\" style=\"fill: var(--text-primary); font-size: 11px;\">$${(d.value/1000000).toFixed(1)}M</text>\n                            </g>`;\n                        }).join('')}\n\n                        <line x1=\"0\" y1=\"${chartHeight}\" x2=\"${chartWidth}\" y2=\"${chartHeight}\" class=\"axis-line\" />\n                    </g>\n                </svg>`;\n\n                container.innerHTML = svgContent;\n            };\n\n            const renderLineChart = () => {\n                const container = document.getElementById('lineChart');\n                if (!container) return;\n\n                const width = container.clientWidth || 400;\n                const height = container.clientHeight || 200;\n\n                const margin = { top: 20, right: 20, bottom: 30, left: 50 };\n                const chartWidth = width - margin.left - margin.right;\n                const chartHeight = height - margin.top - margin.bottom;\n\n                const maxVal = Math.max(...lineData.map(d => d.value)) * 1.1;\n                const minVal = Math.min(...lineData.map(d => d.value)) * 0.9;\n                const range = maxVal - minVal;\n                \n                const points = lineData.map((d, i) => {\n                    const x = (i / (lineData.length - 1)) * chartWidth;\n                    const normalizedY = (d.value - minVal) / range;\n                    const y = chartHeight - (normalizedY * chartHeight);\n                    return `${x},${y}`;\n                }).join(' ');\n\n                const areaPath = `${points} ${chartWidth},${chartHeight} 0,${chartHeight}`;\n\n                let svgContent = `\n                <svg viewBox=\"0 0 ${width} ${height}\" preserveAspectRatio=\"xMidYMid meet\" style=\"width:100%; height:100%; display:block;\">\n                    <defs>\n                        <linearGradient id=\"lineGradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                            <stop offset=\"0%\" stop-color=\"#2fbf71\" stop-opacity=\"0.4\"/>\n                            <stop offset=\"100%\" stop-color=\"#2fbf71\" stop-opacity=\"0.0\"/>\n                        </linearGradient>\n                    </defs>\n                    <g transform=\"translate(${margin.left}, ${margin.top})\">\n                        ${[0, 0.5, 1].map(level => {\n                            const y = chartHeight * level;\n                            return `<line x1=\"0\" y1=\"${y}\" x2=\"${chartWidth}\" y2=\"${y}\" class=\"grid-line\" />`;\n                        }).join('')}\n\n                        <path d=\"${areaPath}\" fill=\"url(#lineGradient)\" stroke=\"none\" />\n\n                        <polyline points=\"${points}\" fill=\"none\" stroke=\"#2fbf71\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n\n                        ${lineData.map((d, i) => {\n                            const x = (i / (lineData.length - 1)) * chartWidth;\n                            const normalizedY = (d.value - minVal) / range;\n                            const y = chartHeight - (normalizedY * chartHeight);\n                            return `\n                            <circle cx=\"${x}\" cy=\"${y}\" r=\"4\" fill=\"#0b0f14\" stroke=\"#2fbf71\" stroke-width=\"2\" />\n                            <text x=\"${x}\" y=\"${y - 10}\" text-anchor=\"middle\" class=\"axis-text\" style=\"fill: var(--text-primary); font-size: 10px;\">${d.value}d</text>\n                            <text x=\"${x}\" y=\"${chartHeight + 15}\" text-anchor=\"middle\" class=\"axis-text\">${d.day}</text>\n                            `;\n                        }).join('')}\n\n                        <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"${chartHeight}\" class=\"axis-line\" />\n                        <line x1=\"0\" y1=\"${chartHeight}\" x2=\"${chartWidth}\" y2=\"${chartHeight}\" class=\"axis-line\" />\n                    </g>\n                </svg>`;\n\n                container.innerHTML = svgContent;\n            };\n\n            const initCharts = () => {\n                renderFunnelChart();\n                renderBarChart();\n                renderLineChart();\n            };\n\n            initCharts();\n\n            window.addEventListener('resize', () => {\n                initCharts();\n            });\n\n            document.getElementById('exportBtn').addEventListener('click', () => {\n                alert('Export functionality simulated.');\n            });\n\n            document.getElementById('timeRange').addEventListener('change', () => {\n                const cards = document.querySelectorAll('.card');\n                cards.forEach(card => {\n                    card.style.opacity = '0.8';\n                    setTimeout(() => {\n                        card.style.opacity = '1';\n                        initCharts();\n                    }, 300);\n                });\n            });\n        });\n    </script>\n</body>\n</html>", "ms": 42767, "pinned": true}