{"node": "ai-ml", "prompt": "Show a demand-forecasting model dashboard with accuracy metrics and a forecast chart.", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Argo Analytics | Demand Forecast Model</title>\n    <style>\n        :root {\n            --bg-color: #0b0f14;\n            --card-bg: rgba(255, 255, 255, 0.04);\n            --card-border: rgba(255, 255, 255, 0.08);\n            --text-primary: #e6edf3;\n            --text-muted: #9ba7b4;\n            --accent-green: #2fbf71;\n            --accent-yellow: #f2c94c;\n            --accent-teal: #21a8a0;\n            --grid-line: rgba(255, 255, 255, 0.06);\n            --axis-line: rgba(255, 255, 255, 0.15);\n            --font-main: system-ui, -apple-system, sans-serif;\n        }\n\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        html, body {\n            background: var(--bg-color);\n            color: var(--text-primary);\n            font-family: var(--font-main);\n            height: 100%;\n            width: 100%;\n            overflow-x: hidden;\n        }\n\n        .dashboard-container {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            grid-template-rows: auto 1fr;\n            gap: 20px;\n            padding: 20px;\n            height: 100%;\n            width: 100%;\n        }\n\n        /* Header / Top Row (KPIs) */\n        .kpi-tile {\n            background: var(--card-bg);\n            border: 1px solid var(--card-border);\n            border-radius: 10px;\n            padding: 20px;\n            display: flex;\n            flex-direction: column;\n            justify-content: space-between;\n            box-shadow: 0 4px 24px rgba(0,0,0,0.4);\n            transition: transform 0.2s ease;\n        }\n\n        .kpi-tile:hover {\n            transform: translateY(-2px);\n            border-color: rgba(255,255,255,0.15);\n        }\n\n        .kpi-label {\n            color: var(--text-muted);\n            font-size: 12px;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            margin-bottom: 8px;\n        }\n\n        .kpi-value {\n            font-size: 32px;\n            font-weight: 700;\n            color: var(--text-primary);\n            line-height: 1;\n        }\n\n        .kpi-subtext {\n            font-size: 14px;\n            margin-top: 10px;\n            display: flex;\n            align-items: center;\n            gap: 6px;\n        }\n\n        .trend-up { color: var(--accent-green); }\n        .trend-down { color: var(--accent-yellow); }\n\n        /* Main Content Area */\n        .main-content {\n            grid-column: 1 / -1;\n            display: grid;\n            grid-template-columns: 2fr 1fr;\n            gap: 20px;\n            height: 100%;\n            min-height: 500px;\n        }\n\n        /* Chart Section */\n        .chart-section {\n            background: var(--card-bg);\n            border: 1px solid var(--card-border);\n            border-radius: 10px;\n            padding: 20px;\n            display: flex;\n            flex-direction: column;\n            box-shadow: 0 4px 24px rgba(0,0,0,0.4);\n        }\n\n        .chart-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 20px;\n        }\n\n        .chart-title {\n            font-size: 18px;\n            font-weight: 600;\n            color: var(--text-primary);\n        }\n\n        .chart-controls {\n            display: flex;\n            gap: 10px;\n        }\n\n        .btn {\n            background: rgba(255,255,255,0.05);\n            border: 1px solid var(--card-border);\n            color: var(--text-muted);\n            padding: 6px 12px;\n            border-radius: 6px;\n            font-size: 12px;\n            cursor: pointer;\n            transition: all 0.2s;\n        }\n\n        .btn:hover, .btn.active {\n            background: var(--accent-green);\n            color: #000;\n            border-color: var(--accent-green);\n            font-weight: 600;\n        }\n\n        .svg-container {\n            flex-grow: 1;\n            width: 100%;\n            position: relative;\n            overflow: hidden;\n        }\n\n        svg {\n            width: 100%;\n            height: 100%;\n            display: block;\n        }\n\n        /* Sidebar / Details Section */\n        .sidebar-section {\n            display: flex;\n            flex-direction: column;\n            gap: 20px;\n        }\n\n        .info-card {\n            background: var(--card-bg);\n            border: 1px solid var(--card-border);\n            border-radius: 10px;\n            padding: 20px;\n            box-shadow: 0 4px 24px rgba(0,0,0,0.4);\n        }\n\n        .info-title {\n            font-size: 16px;\n            font-weight: 600;\n            margin-bottom: 12px;\n            color: var(--text-primary);\n            border-bottom: 1px solid var(--card-border);\n            padding-bottom: 10px;\n        }\n\n        .metric-row {\n            display: flex;\n            justify-content: space-between;\n            margin-bottom: 10px;\n            font-size: 14px;\n        }\n\n        .metric-label { color: var(--text-muted); }\n        .metric-value { font-family: monospace; color: var(--text-primary); }\n\n        .model-summary {\n            font-size: 14px;\n            line-height: 1.6;\n            color: var(--text-muted);\n        }\n\n        .model-summary p { margin-bottom: 10px; }\n        \n        .highlight-text { color: var(--accent-teal); font-weight: 500; }\n\n        .confidence-band {\n            margin-top: 15px;\n            padding: 12px;\n            background: rgba(33, 168, 160, 0.1);\n            border-radius: 8px;\n            border-left: 3px solid var(--accent-teal);\n        }\n\n        .confidence-text {\n            font-size: 13px;\n            color: var(--text-primary);\n        }\n\n        /* Responsive adjustments */\n        @media (max-width: 900px) {\n            .main-content {\n                grid-template-columns: 1fr;\n                grid-template-rows: 1fr auto;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"dashboard-container\">\n        <!-- Top Row KPIs -->\n        <div class=\"kpi-tile\">\n            <div>\n                <div class=\"kpi-label\">Model Accuracy (R\u00b2)</div>\n                <div class=\"kpi-value\" id=\"r2-value\">0.94</div>\n            </div>\n            <div class=\"kpi-subtext\">\n                <span class=\"trend-up\">\u25b2 2.4%</span>\n                <span class=\"kpi-label\" style=\"margin-left: 4px; color: var(--text-muted);\">vs last month</span>\n            </div>\n        </div>\n\n        <div class=\"kpi-tile\">\n            <div>\n                <div class=\"kpi-label\">Mean Absolute Error</div>\n                <div class=\"kpi-value\" id=\"mae-value\">1,240</div>\n            </div>\n            <div class=\"kpi-subtext\">\n                <span class=\"trend-down\">\u25bc 8.1%</span>\n                <span class=\"kpi-label\" style=\"margin-left: 4px; color: var(--text-muted);\">Improvement</span>\n            </div>\n        </div>\n\n        <div class=\"kpi-tile\">\n            <div>\n                <div class=\"kpi-label\">Forecast Confidence</div>\n                <div class=\"kpi-value\" id=\"confidence-value\">92%</div>\n            </div>\n            <div class=\"kpi-subtext\">\n                <span class=\"trend-up\">Stable</span>\n                <span class=\"kpi-label\" style=\"margin-left: 4px; color: var(--text-muted);\">Within 95% threshold</span>\n            </div>\n        </div>\n\n        <div class=\"kpi-tile\">\n            <div>\n                <div class=\"kpi-label\">Top Driver</div>\n                <div class=\"kpi-value\" style=\"font-size: 24px; color: var(--accent-teal);\">Seasonality</div>\n            </div>\n            <div class=\"kpi-subtext\">\n                <span class=\"kpi-label\">Weight: 0.84</span>\n            </div>\n        </div>\n\n        <!-- Main Content -->\n        <div class=\"main-content\">\n            <!-- Chart Section -->\n            <div class=\"chart-section\">\n                <div class=\"chart-header\">\n                    <div class=\"chart-title\">Demand Forecast: Next 90 Days</div>\n                    <div class=\"chart-controls\">\n                        <button class=\"btn active\" onclick=\"updateChart('actual')\">Actual vs Pred</button>\n                        <button class=\"btn\" onclick=\"updateChart('breakdown')\">Category Breakdown</button>\n                        <button class=\"btn\" onclick=\"updateChart('cumulative')\">Cumulative</button>\n                    </div>\n                </div>\n                <div class=\"svg-container\" id=\"chart-container\">\n                    <!-- SVG Chart will be rendered here -->\n                    <svg id=\"main-chart\" viewBox=\"0 0 800 400\" preserveAspectRatio=\"none\">\n                        <defs>\n                            <linearGradient id=\"areaGradient\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n                                <stop offset=\"0%\" stop-color=\"#2fbf71\" stop-opacity=\"0.25\"/>\n                                <stop offset=\"100%\" stop-color=\"#2fbf71\" stop-opacity=\"0\"/>\n                            </linearGradient>\n                            <linearGradient id=\"areaGradientPred\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n                                <stop offset=\"0%\" stop-color=\"#21a8a0\" stop-opacity=\"0.25\"/>\n                                <stop offset=\"100%\" stop-color=\"#21a8a0\" stop-opacity=\"0\"/>\n                            </linearGradient>\n                        </defs>\n                        \n                        <!-- Grid Lines (Y) -->\n                        <g id=\"grid-y\">\n                            <line x1=\"0\" y1=\"350\" x2=\"800\" y2=\"350\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                            <line x1=\"0\" y1=\"275\" x2=\"800\" y2=\"275\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                            <line x1=\"0\" y1=\"200\" x2=\"800\" y2=\"200\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                            <line x1=\"0\" y1=\"125\" x2=\"800\" y2=\"125\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                            <line x1=\"0\" y1=\"50\" x2=\"800\" y2=\"50\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                        </g>\n\n                        <!-- Grid Lines (X) -->\n                        <g id=\"grid-x\">\n                            <line x1=\"80\" y1=\"50\" x2=\"80\" y2=\"350\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                            <line x1=\"160\" y1=\"50\" x2=\"160\" y2=\"350\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                            <line x1=\"240\" y1=\"50\" x2=\"240\" y2=\"350\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                            <line x1=\"320\" y1=\"50\" x2=\"320\" y2=\"350\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                            <line x1=\"400\" y1=\"50\" x2=\"400\" y2=\"350\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                            <line x1=\"480\" y1=\"50\" x2=\"480\" y2=\"350\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                            <line x1=\"560\" y1=\"50\" x2=\"560\" y2=\"350\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                            <line x1=\"640\" y1=\"50\" x2=\"640\" y2=\"350\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                            <line x1=\"720\" y1=\"50\" x2=\"720\" y2=\"350\" stroke=\"var(--grid-line)\" stroke-width=\"1\" />\n                        </g>\n\n                        <!-- Axes -->\n                        <g id=\"axes\">\n                            <line x1=\"50\" y1=\"350\" x2=\"780\" y2=\"350\" stroke=\"var(--axis-line)\" stroke-width=\"1.5\" />\n                            <line x1=\"50\" y1=\"350\" x2=\"50\" y2=\"50\" stroke=\"var(--axis-line)\" stroke-width=\"1.5\" />\n                        </g>\n\n                        <!-- Data Series: Actual Demand (Green) -->\n                        <path id=\"path-actual\" d=\"M50,300 L130,280 L210,250 L290,290 L370,210 L450,180 L530,150 L610,190 L690,140\" \n                              fill=\"none\" stroke=\"var(--accent-green)\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n\n                        <!-- Data Series: Forecast (Teal) -->\n                        <path id=\"path-forecast\" d=\"M690,140 L740,130 L770,110\" \n                              fill=\"none\" stroke=\"var(--accent-teal)\" stroke-width=\"3\" stroke-dasharray=\"6,4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n\n                        <!-- Area Fill for Actual -->\n                        <path id=\"area-actual\" d=\"M50,300 L130,280 L210,250 L290,290 L370,210 L450,180 L530,150 L610,190 L690,140 L690,350 L50,350 Z\" \n                              fill=\"url(#areaGradient)\" stroke=\"none\" />\n\n                        <!-- Area Fill for Forecast Confidence (Teal) -->\n                        <path id=\"area-forecast\" d=\"M690,140 L740,130 L770,110 L770,160 L740,180 L690,190 Z\" \n                              fill=\"url(#areaGradientPred)\" stroke=\"none\" opacity=\"0.6\" />\n\n                        <!-- Labels -->\n                        <text x=\"20\" y=\"355\" fill=\"var(--text-muted)\" font-size=\"10\">0</text>\n                        <text x=\"20\" y=\"200\" fill=\"var(--text-muted)\" font-size=\"10\">25k</text>\n                        <text x=\"20\" y=\"55\" fill=\"var(--text-muted)\" font-size=\"10\">50k</text>\n                        \n                        <text x=\"50\" y=\"370\" fill=\"var(--text-muted)\" font-size=\"10\" text-anchor=\"middle\">Oct 1</text>\n                        <text x=\"290\" y=\"370\" fill=\"var(--text-muted)\" font-size=\"10\" text-anchor=\"middle\">Oct 15</text>\n                        <text x=\"530\" y=\"370\" fill=\"var(--text-muted)\" font-size=\"10\" text-anchor=\"middle\">Oct 30</text>\n                        <text x=\"720\" y=\"370\" fill=\"var(--text-muted)\" font-size=\"10\" text-anchor=\"middle\" style=\"fill:var(--accent-teal)\">Nov 10 (Forecast)</text>\n\n                        <!-- Legend -->\n                        <g transform=\"translate(600, 30)\">\n                            <circle cx=\"15\" cy=\"0\" r=\"4\" fill=\"var(--accent-green)\" />\n                            <text x=\"25\" y=\"4\" fill=\"var(--text-muted)\" font-size=\"12\">Actual Demand</text>\n                            <circle cx=\"100\" cy=\"0\" r=\"4\" fill=\"var(--accent-teal)\" />\n                            <text x=\"110\" y=\"4\" fill=\"var(--text-muted)\" font-size=\"12\">Forecast</text>\n                        </g>\n                    </svg>\n                </div>\n            </div>\n\n            <!-- Sidebar Info -->\n            <div class=\"sidebar-section\">\n                <!-- Model Summary -->\n                <div class=\"info-card\">\n                    <div class=\"info-title\">Model Performance Analysis</div>\n                    <div class=\"model-summary\">\n                        <p>The <strong>Prophet-Ensemble</strong> model is currently outperforming baseline predictions by 14% in low-error scenarios.</p>\n                        <p>Key insight: <span class=\"highlight-text\">Seasonal spikes</span> are being detected 3 days earlier than previous iterations due to updated holiday weighting.</p>\n                        <p>Recommendation: Increase inventory stock for \"Category A\" products by 12% for the upcoming holiday week.</p>\n                    </div>\n                </div>\n\n                <!-- Detailed Metrics -->\n                <div class=\"info-card\">\n                    <div class=\"info-title\">Detailed Metrics</div>\n                    <div class=\"metric-row\">\n                        <span class=\"metric-label\">Root Mean Squared Error (RMSE)</span>\n                        <span class=\"metric-value\">1,850</span>\n                    </div>\n                    <div class=\"metric-row\">\n                        <span class=\"metric-label\">Mean Absolute Percentage Error (MAPE)</span>\n                        <span class=\"metric-value\">4.2%</span>\n                    </div>\n                    <div class=\"metric-row\">\n                        <span class=\"metric-label\">Training Data Size</span>\n                        <span class=\"metric-value\">2.4M Records</span>\n                    </div>\n                    <div class=\"metric-row\">\n                        <span class=\"metric-label\">Last Updated</span>\n                        <span class=\"metric-value\">Today, 08:00 AM</span>\n                    </div>\n                    <div class=\"metric-row\">\n                        <span class=\"metric-label\">Data Latency</span>\n                        <span class=\"metric-value\">&lt; 15 mins</span>\n                    </div>\n                </div>\n\n                <!-- Confidence Interval -->\n                <div class=\"confidence-band\">\n                    <div class=\"info-title\" style=\"font-size: 14px; margin-bottom: 8px;\">Forecast Confidence Interval (95%)</div>\n                    <div class=\"confidence-text\">\n                        <p>There is a 95% probability that actual demand will fall between <strong>48,200</strong> and <strong>53,800</strong> units by Nov 10th.</p>\n                        <p style=\"margin-top: 8px; font-size: 12px; color: var(--text-muted);\">Upper bound is adjusted upward due to supply chain volatility indices.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            // Interactive Chart Logic\n            const chart = document.getElementById('main-chart');\n            const pathActual = document.getElementById('path-actual');\n            const pathForecast = document.getElementById('path-forecast');\n            const areaActual = document.getElementById('area-actual');\n            const areaForecast = document.getElementById('area-forecast');\n            const btns = document.querySelectorAll('.btn');\n\n            // Data points for the chart (Y values scaled for viewBox 0 0 800 400)\n            // Actual Data (9 points)\n            const actualData = [300, 280, 250, 290, 210, 180, 150, 190, 140];\n            // Forecast Data (3 points) - connects to the last point of actual (140)\n            const forecastData = [140, 130, 110]; \n            \n            // X Coordinates for 12 points (9 actual + 3 forecast)\n            const xCoords = [50, 130, 210, 290, 370, 450, 530, 610, 690, 740, 770]; // Note: 770 is end of chart\n            \n            // Helper to generate path strings\n            function generatePath(data, startY, isForecast = false) {\n                let d = `M ${xCoords[0]},${startY} `;\n                data.forEach((y, index) => {\n                    // If it's forecast data, we need to offset the xCoords index\n                    const xIndex = isForecast ? index + 9 : index;\n                    d += `L ${xCoords[xIndex]},${y} `;\n                });\n                return d;\n            }\n\n            // Helper to generate area path (closing the loop to bottom)\n            function generateAreaPath(d, bottomY) {\n                return d + ` L ${xCoords[xCoords.length-1]},${bottomY} L ${xCoords[0]},${bottomY} Z`;\n            }\n\n            // Initial Render State\n            let currentView = 'actual';\n\n            // View Functions\n            const views = {\n                actual: {\n                    actualPath: generatePath(actualData, 300), // Start at 300\n                    forecastPath: generatePath(forecastData, 300, true), // Start at 300 (fake start for visual separation)\n                    areaActual: generateAreaPath(generatePath(actualData, 300), 350),\n                    areaForecast: \"M 0 0\", // Hide forecast area\n                    labels: ['Oct 1', 'Oct 15', 'Oct 30', 'Nov 10']\n                },\n                breakdown: {\n                    // Simulate a more complex chart with multiple lines\n                    actualPath: \"M50,300 L130,280 L210,250 L290,290 L370,210 L450,180 L530,150 L610,190 L690,140\",\n                    forecastPath: \"M690,140 L740,130 L770,110\",\n                    areaActual: generateAreaPath(\"M50,300 L130,280 L210,250 L290,290 L370,210 L450,180 L530,150 L610,190 L690,140\", 350),\n                    areaForecast: \"M690,140 L740,130 L770,110 L770,160 L740,180 L690,190 Z\",\n                    labels: ['Oct 1', 'Oct 15', 'Oct 30', 'Nov 10']\n                },\n                cumulative: {\n                    // Simulate cumulative curve\n                    actualPath: \"M50,350 L130,320 L210,280 L290,240 L370,180 L450,120 L530,80 L610,60 L690,40\",\n                    forecastPath: \"M690,40 L740,30 L770,20\",\n                    areaActual: \"M50,350 L130,320 L210,280 L290,240 L370,180 L450,120 L530,80 L610,60 L690,40 L690,350 L50,350 Z\",\n                    areaForecast: \"M690,40 L740,30 L770,20 L770,350 L690,350 Z\",\n                    labels: ['Oct 1', 'Oct 15', 'Oct 30', 'Nov 10']\n                }\n            };\n\n            function updateChart(viewName) {\n                currentView = viewName;\n                \n                // Update Buttons\n                btns.forEach(btn => {\n                    if(btn.innerText.toLowerCase().includes(viewName === 'actual' ? 'actual' : viewName === 'breakdown' ? 'breakdown' : 'cumulative')) {\n                        btn.classList.add('active');\n                    } else {\n                        btn.classList.remove('active');\n                    }\n                });\n\n                // Update SVG Paths\n                if (viewName === 'actual') {\n                    pathActual.setAttribute('d', views.actual.actualPath);\n                    pathForecast.setAttribute('d', \"M0,0\"); // Hide forecast line\n                    areaActual.setAttribute('d', views.actual.areaActual);\n                    areaForecast.setAttribute('d', \"M0,0\");\n                    \n                    // Reset Legend\n                    const legend = document.querySelector('g[transform=\"translate(600, 30)\"]');\n                    legend.innerHTML = `<circle cx=\"15\" cy=\"0\" r=\"4\" fill=\"var(--accent-green)\" /><text x=\"25\" y=\"4\" fill=\"var(--text-muted)\" font-size=\"12\">Actual Demand</text>`;\n                } \n                else if (viewName === 'breakdown') {\n                    pathActual.setAttribute('d', views.breakdown.actualPath);\n                    pathForecast.setAttribute('d', views.breakdown.forecastPath);\n                    areaActual.setAttribute('d', views.breakdown.areaActual);\n                    areaForecast.setAttribute('d', views.breakdown.areaForecast);\n                    \n                    // Update Legend\n                    const legend = document.querySelector('g[transform=\"translate(600, 30)\"]');\n                    legend.innerHTML = `<circle cx=\"15\" cy=\"0\" r=\"4\" fill=\"var(--accent-green)\" /><text x=\"25\" y=\"4\" fill=\"var(--text-muted)\" font-size=\"12\">Actual Demand</text><circle cx=\"100\" cy=\"0\" r=\"4\" fill=\"var(--accent-teal)\" /><text x=\"110\" y=\"4\" fill=\"var(--text-muted)\" font-size=\"12\">Forecast</text>`;\n                }\n                else if (viewName === 'cumulative') {\n                    pathActual.setAttribute('d', views.cumulative.actualPath);\n                    pathForecast.setAttribute('d', views.cumulative.forecastPath);\n                    areaActual.setAttribute('d', views.cumulative.areaActual);\n                    areaForecast.setAttribute('d', views.cumulative.areaForecast);\n                    \n                    // Update Legend\n                    const legend = document.querySelector('g[transform=\"translate(600, 30)\"]');\n                    legend.innerHTML = `<circle cx=\"15\" cy=\"0\" r=\"4\" fill=\"var(--accent-green)\" /><text x=\"25\" y=\"4\" fill=\"var(--text-muted)\" font-size=\"12\">Cumulative Demand</text><circle cx=\"100\" cy=\"0\" r=\"4\" fill=\"var(--accent-teal)\" /><text x=\"110\" y=\"4\" fill=\"var(--text-muted)\" font-size=\"12\">Projection</text>`;\n                }\n            }\n\n            // Add simple tooltip logic\n            const svgContainer = document.getElementById('chart-container');\n            const tooltip = document.createElement('div');\n            tooltip.style.position = 'absolute';\n            tooltip.style.background = 'rgba(0,0,0,0.9)';\n            tooltip.style.color = '#fff';\n            tooltip.style.padding = '8px 12px';\n            tooltip.style.borderRadius = '6px';\n            tooltip.style.fontSize = '12px';\n            tooltip.style.pointerEvents = 'none';\n            tooltip.style.display = 'none';\n            tooltip.style.zIndex = '100';\n            svgContainer.appendChild(tooltip);\n\n            svgContainer.addEventListener('mousemove', (e) => {\n                const rect = svgContainer.getBoundingClientRect();\n                const x = e.clientX - rect.left;\n                const y = e.clientY - rect.top;\n                \n                // Simple proximity check for tooltip\n                // This is a mock interaction logic\n                if (x > 50 && x < 770 && y > 50 && y < 350) {\n                    tooltip.style.display = 'block';\n                    tooltip.style.left = `${e.clientX + 10}px`;\n                    tooltip.style.top = `${e.clientY + 10}px`;\n                    \n                    // Mock values based on X position\n                    const days = Math.round((x - 50) / (720/12));\n                    const demand = Math.floor(30000 + (Math.random() * 20000));\n                    tooltip.innerHTML = `<strong>Day ${days}</strong><br>Demand: ${demand.toLocaleString()}`;\n                } else {\n                    tooltip.style.display = 'none';\n                }\n            });\n        });\n    </script>\n</body>\n</html>", "ms": 47624, "pinned": false}