{"node": "data-engineering", "prompt": "Change the source connector from REST API to Kafka streaming and update the transformation code.", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Argo Analytics - Data Pipeline Visualization</title>\n    <style>\n        :root {\n            --bg-color: #0b0f14;\n            --card-bg: rgba(255, 255, 255, 0.04);\n            --border-color: rgba(255, 255, 255, 0.08);\n            --text-primary: #e6edf3;\n            --text-muted: #9ba7b4;\n            --accent-green: #2fbf71;\n            --accent-teal: #21a8a0;\n            --accent-yellow: #f2c94c;\n            --font-main: system-ui, -apple-system, sans-serif;\n        }\n\n        * {\n            box-sizing: border-box;\n        }\n\n        html, body {\n            background: var(--bg-color);\n            color: var(--text-primary);\n            font-family: var(--font-main);\n            margin: 0;\n            padding: 0;\n            height: 100%;\n            overflow: hidden;\n        }\n\n        .container {\n            display: flex;\n            height: 100vh;\n            width: 100vw;\n            padding: 20px;\n            gap: 20px;\n        }\n\n        /* Left Column: Pipeline Visualization */\n        .pipeline-section {\n            flex: 5.5;\n            display: flex;\n            flex-direction: column;\n            gap: 20px;\n        }\n\n        .header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 10px;\n        }\n\n        .title {\n            font-size: 24px;\n            font-weight: 600;\n            letter-spacing: 0.5px;\n        }\n\n        .status-badge {\n            background: rgba(47, 191, 113, 0.15);\n            color: var(--accent-green);\n            padding: 6px 12px;\n            border-radius: 20px;\n            font-size: 12px;\n            font-weight: 600;\n            border: 1px solid var(--accent-green);\n        }\n\n        .canvas-container {\n            flex: 1;\n            background: var(--card-bg);\n            border: 1px solid var(--border-color);\n            border-radius: 10px;\n            position: relative;\n            overflow: hidden;\n            box-shadow: 0 4px 24px rgba(0,0,0,0.4);\n        }\n\n        svg {\n            width: 100%;\n            height: 100%;\n            display: block;\n        }\n\n        /* SVG Elements Styling */\n        .node-rect {\n            fill: #161b22;\n            stroke: var(--border-color);\n            stroke-width: 1.5;\n            rx: 8;\n            transition: all 0.3s ease;\n        }\n\n        .node-icon {\n            fill: var(--text-primary);\n        }\n\n        .node-label {\n            fill: var(--text-primary);\n            font-size: 14px;\n            font-weight: 600;\n            text-anchor: middle;\n            dominant-baseline: middle;\n        }\n\n        .node-sublabel {\n            fill: var(--text-muted);\n            font-size: 11px;\n            text-anchor: middle;\n            dominant-baseline: middle;\n        }\n\n        .connector {\n            stroke: var(--border-color);\n            stroke-width: 1.5;\n            fill: none;\n            transition: stroke 0.3s ease;\n        }\n\n        .connector.active {\n            stroke: var(--accent-green);\n            stroke-dasharray: 5;\n            animation: dash-flow 2s linear infinite;\n        }\n\n        .connector-label {\n            fill: var(--text-muted);\n            font-size: 10px;\n            text-anchor: middle;\n            background-color: var(--bg-color);\n            padding: 2px 4px;\n        }\n\n        /* Tooltip */\n        .tooltip {\n            position: absolute;\n            background: rgba(11, 15, 20, 0.95);\n            border: 1px solid var(--border-color);\n            padding: 12px;\n            border-radius: 8px;\n            pointer-events: none;\n            display: none;\n            z-index: 100;\n            box-shadow: 0 8px 24px rgba(0,0,0,0.6);\n            backdrop-filter: blur(4px);\n            min-width: 200px;\n        }\n\n        .tooltip h3 {\n            margin: 0 0 8px 0;\n            font-size: 14px;\n            color: var(--accent-green);\n            border-bottom: 1px solid var(--border-color);\n            padding-bottom: 6px;\n        }\n\n        .tooltip p {\n            margin: 4px 0;\n            font-size: 12px;\n            color: var(--text-primary);\n        }\n\n        .tooltip span {\n            color: var(--text-muted);\n        }\n\n        /* Right Column: Code Editor */\n        .code-section {\n            flex: 4.5;\n            display: flex;\n            flex-direction: column;\n            gap: 20px;\n        }\n\n        .editor-card {\n            flex: 1;\n            background: #0d1117;\n            border: 1px solid var(--border-color);\n            border-radius: 10px;\n            overflow: hidden;\n            box-shadow: 0 4px 24px rgba(0,0,0,0.4);\n            display: flex;\n            flex-direction: column;\n        }\n\n        .editor-header {\n            padding: 12px 16px;\n            background: #161b22;\n            border-bottom: 1px solid var(--border-color);\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n\n        .file-icon {\n            width: 16px;\n            height: 16px;\n            fill: var(--accent-yellow);\n        }\n\n        .file-name {\n            font-size: 13px;\n            font-family: monospace;\n            color: var(--text-primary);\n        }\n\n        .code-content {\n            flex: 1;\n            padding: 20px;\n            overflow: auto;\n            font-family: 'Courier New', Courier, monospace;\n            font-size: 13px;\n            line-height: 1.6;\n            color: #d0d7de;\n        }\n\n        /* Syntax Highlighting Classes */\n        .kwd { color: #ff7b72; } /* Keyword */\n        .fn { color: #d2a8ff; }  /* Function */\n        .str { color: #a5d6ff; } /* String */\n        .num { color: #79c0ff; } /* Number */\n        .com { color: #8b949e; font-style: italic; } /* Comment */\n        .var { color: #7ee787; } /* Variable */\n        .cls { color: #7ee787; } /* Class/Type */\n\n        .log-panel {\n            height: 150px;\n            background: #0d1117;\n            border-top: 1px solid var(--border-color);\n            padding: 15px;\n            font-family: monospace;\n            font-size: 12px;\n            overflow-y: auto;\n        }\n\n        .log-entry {\n            margin-bottom: 6px;\n            border-bottom: 1px solid #21262d;\n            padding-bottom: 4px;\n        }\n        .log-time { color: var(--text-muted); margin-right: 10px; }\n        .log-info { color: var(--accent-teal); }\n        .log-warn { color: var(--accent-yellow); }\n        .log-success { color: var(--accent-green); }\n\n        /* Responsive adjustments */\n        @media (max-width: 900px) {\n            .container { flex-direction: column; overflow-y: auto; }\n            .pipeline-section, .code-section { flex: none; width: 100%; height: auto; }\n            .canvas-container { height: 400px; }\n            .log-panel { height: 200px; }\n        }\n\n        @keyframes dash-flow {\n            to { stroke-dashoffset: -20; }\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"container\">\n    <!-- Left Column: Pipeline Visualization -->\n    <section class=\"pipeline-section\">\n        <div class=\"header\">\n            <div class=\"title\">Data Pipeline: Customer Analytics</div>\n            <div class=\"status-badge\">\u25cf Live Streaming (Latency: 2.4s)</div>\n        </div>\n        \n        <div class=\"canvas-container\" id=\"pipelineCanvas\">\n            <svg id=\"svgCanvas\" preserveAspectRatio=\"xMidYMid meet\">\n                <defs>\n                    <linearGradient id=\"gradient-green\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                        <stop offset=\"0%\" style=\"stop-color:var(--accent-green);stop-opacity:0.2\" />\n                        <stop offset=\"100%\" style=\"stop-color:var(--accent-green);stop-opacity:0\" />\n                    </linearGradient>\n                </defs>\n                \n                <!-- Background Grid -->\n                <g id=\"grid\">\n                    <path d=\"M0 100 H1000 M0 300 H1000 M0 500 H1000\" stroke=\"rgba(255,255,255,0.03)\" stroke-width=\"1\" />\n                </g>\n\n                <!-- Connections (Drawn first so they appear behind nodes) -->\n                <g id=\"connections\">\n                    <!-- Source to Staging -->\n                    <path id=\"conn-1\" class=\"connector\" d=\"M250 100 L450 100\" />\n                    <text x=\"350\" y=\"85\" class=\"connector-label\" style=\"fill: var(--accent-teal);\">JSON / Avro</text>\n                    \n                    <!-- Staging to Intermediate -->\n                    <path id=\"conn-2\" class=\"connector\" d=\"M450 300 L650 300\" />\n                    <text x=\"550\" y=\"285\" class=\"connector-label\" style=\"fill: var(--accent-teal);\">Partitioned Parquet</text>\n\n                    <!-- Intermediate to BI -->\n                    <path id=\"conn-3\" class=\"connector\" d=\"M650 500 L850 500\" />\n                    <text x=\"750\" y=\"485\" class=\"connector-label\" style=\"fill: var(--accent-teal);\">Star Schema</text>\n                </g>\n\n                <!-- Node 1: Source (Kafka) -->\n                <g id=\"node-source\" class=\"node\" transform=\"translate(100, 60)\">\n                    <rect class=\"node-rect\" width=\"150\" height=\"80\" rx=\"8\" />\n                    <circle cx=\"75\" cy=\"40\" r=\"20\" fill=\"#21a8a0\" opacity=\"0.2\" />\n                    <path class=\"node-icon\" d=\"M60 30 L90 30 L90 50 L60 50 Z M75 20 L95 40 L75 60 L55 40 Z\" transform=\"scale(0.6) translate(75,40)\" fill=\"#21a8a0\"/>\n                    <text x=\"75\" y=\"70\" class=\"node-label\">Kafka Cluster</text>\n                    <text x=\"75\" y=\"85\" class=\"node-sublabel\">Topic: user_events</text>\n                </g>\n\n                <!-- Node 2: Staging -->\n                <g id=\"node-staging\" class=\"node\" transform=\"translate(300, 260)\">\n                    <rect class=\"node-rect\" width=\"150\" height=\"80\" rx=\"8\" />\n                    <rect class=\"node-icon\" x=\"45\" y=\"25\" width=\"60\" height=\"50\" rx=\"4\" fill=\"#f2c94c\" opacity=\"0.2\"/>\n                    <text x=\"75\" y=\"50\" class=\"node-label\" fill=\"#f2c94c\">Raw Zone</text>\n                    <text x=\"75\" y=\"70\" class=\"node-sublabel\">Delta Lake</text>\n                    <text x=\"75\" y=\"85\" class=\"node-sublabel\">user_events_raw</text>\n                </g>\n\n                <!-- Node 3: Intermediate -->\n                <g id=\"node-intermediate\" class=\"node\" transform=\"translate(500, 460)\">\n                    <rect class=\"node-rect\" width=\"150\" height=\"80\" rx=\"8\" />\n                    <circle cx=\"75\" cy=\"40\" r=\"20\" fill=\"#2fbf71\" opacity=\"0.2\" />\n                    <text x=\"75\" y=\"50\" class=\"node-label\" fill=\"#2fbf71\">Cleaned Zone</text>\n                    <text x=\"75\" y=\"70\" class=\"node-sublabel\">dbt Models</text>\n                    <text x=\"75\" y=\"85\" class=\"node-sublabel\">f_user_actions</text>\n                </g>\n\n                <!-- Node 4: BI -->\n                <g id=\"node-bi\" class=\"node\" transform=\"translate(700, 660)\">\n                    <rect class=\"node-rect\" width=\"150\" height=\"80\" rx=\"8\" />\n                    <path class=\"node-icon\" d=\"M30 60 L45 20 L105 20 L120 60 L30 60 Z M60 40 L90 40\" stroke=\"#2fbf71\" stroke-width=\"6\" stroke-linecap=\"round\" fill=\"none\"/>\n                    <text x=\"75\" y=\"50\" class=\"node-label\" fill=\"#2fbf71\">Analytics Layer</text>\n                    <text x=\"75\" y=\"70\" class=\"node-sublabel\">Snowflake</text>\n                    <text x=\"75\" y=\"85\" class=\"node-sublabel\">dm_user_metrics</text>\n                </g>\n\n            </svg>\n\n            <div id=\"tooltip\" class=\"tooltip\">\n                <h3 id=\"tt-title\">Node Title</h3>\n                <p id=\"tt-desc\">Description goes here.</p>\n                <p><span>Records/sec:</span> <span id=\"tt-rate\">0</span></p>\n                <p><span>Status:</span> <span id=\"tt-status\" style=\"color: var(--accent-green)\">Active</span></p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Right Column: Code Editor -->\n    <section class=\"code-section\">\n        <div class=\"editor-card\">\n            <div class=\"editor-header\">\n                <svg class=\"file-icon\" viewBox=\"0 0 24 24\">\n                    <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z\"></path>\n                    <path d=\"M14 2v6h6\"></path>\n                    <path d=\"M16 13H8\"></path>\n                    <path d=\"M16 17H8\"></path>\n                    <path d=\"M10 9H8\"></path>\n                </svg>\n                <div class=\"file-name\">models/staging/stg_kafka_user_events.sql</div>\n            </div>\n            \n            <div class=\"code-content\" id=\"codeEditor\">\n<span class=\"com\"># Source: Kafka Streaming (JSON Format)</span>\n<span class=\"kwd\">WITH</span> <span class=\"var\">raw_kafka_data</span> <span class=\"kwd\">AS</span> (\n    <span class=\"kwd\">SELECT</span>\n        <span class=\"var\">convert_from_bytes</span>(<span class=\"var\">message_bytes</span>, <span class=\"str\">'UTF8'</span>) <span class=\"kwd\">as</span> <span class=\"var\">raw_json</span>,\n        <span class=\"var\">topic</span>,\n        <span class=\"var\">partition</span>,\n        <span class=\"var\">offset</span>,\n        <span class=\"var\">timestamp</span>\n    <span class=\"kwd\">FROM</span> \n        <span class=\"var\">kafka_source.user_events_raw</span>\n),\n\n<span class=\"var\">parsed_events</span> <span class=\"kwd\">AS</span> (\n    <span class=\"kwd\">SELECT</span>\n        <span class=\"var\">raw_json</span>.<span class=\"var\">event_id</span>,\n        <span class=\"var\">raw_json</span>.<span class=\"var\">user_id</span>,\n        <span class=\"var\">raw_json</span>.<span class=\"var\">event_type</span>,\n        <span class=\"var\">raw_json</span>.<span class=\"var\">properties</span>.<span class=\"var\">page_url</span> <span class=\"kwd\">as</span> <span class=\"var\">page_url</span>,\n        <span class=\"var\">raw_json</span>.<span class=\"var\">properties</span>.<span class=\"var\">session_id</span> <span class=\"kwd\">as</span> <span class=\"var\">session_id</span>,\n        <span class=\"var\">raw_json</span>.<span class=\"var\">ingest_timestamp</span>,\n        <span class=\"var\">timestamp</span> <span class=\"kwd\">as</span> <span class=\"var\">stream_time</span>\n    <span class=\"kwd\">FROM</span> <span class=\"var\">raw_kafka_data</span>\n),\n\n<span class=\"var\">enriched_data</span> <span class=\"kwd\">AS</span> (\n    <span class=\"kwd\">SELECT</span>\n        <span class=\"var\">event_id</span>,\n        <span class=\"var\">user_id</span>,\n        <span class=\"var\">event_type</span>,\n        <span class=\"var\">page_url</span>,\n        <span class=\"var\">session_id</span>,\n        <span class=\"var\">stream_time</span>,\n        <span class=\"fn\">DATE</span>(<span class=\"var\">stream_time</span>) <span class=\"kwd\">as</span> <span class=\"var\">event_date</span>,\n        <span class=\"fn\">HASH</span>(<span class=\"var\">user_id</span>) <span class=\"kwd\">as</span> <span class=\"var\">user_hash</span>  <span class=\"com\"># Anonymization</span>\n    <span class=\"kwd\">FROM</span> <span class=\"var\">parsed_events</span>\n    <span class=\"kwd\">WHERE</span> <span class=\"var\">user_id</span> <span class=\"kwd\">IS NOT NULL</span>\n)\n\n<span class=\"kwd\">SELECT</span> * <span class=\"kwd\">FROM</span> <span class=\"var\">enriched_data</span>\n            </div>\n\n            <div class=\"log-panel\" id=\"logPanel\">\n                <div class=\"log-entry\"><span class=\"log-time\">10:42:05</span> <span class=\"log-info\">[SYSTEM]</span> Initializing Kafka Consumer Group: argo_pipeline_v2</span></div>\n                <div class=\"log-entry\"><span class=\"log-time\">10:42:06</span> <span class=\"log-success\">[CONNECT]</span> Connected to broker-03.kafka-cluster.internal:9092</span></div>\n                <div class=\"log-entry\"><span class=\"log-time\">10:42:07</span> <span class=\"log-info\">[STREAM]</span> Subscribed to topic: user_events (Partitions: 4)</span></div>\n                <div class=\"log-entry\"><span class=\"log-time\">10:42:08</span> <span class=\"log-warn\">[LAG]</span> Consumer lag detected on partition 2: 1,204 messages</span></div>\n                <div class=\"log-entry\"><span class=\"log-time\">10:42:10</span> <span class=\"log-success\">[TRANSFORM]</span> dbt model started: stg_kafka_user_events</span></div>\n                <div class=\"log-entry\"><span class=\"log-time\">10:42:11</span> <span class=\"log-success\">[TRANSFORM]</span> Filtered 150 invalid records (NULL user_id)</span></div>\n                <div class=\"log-entry\"><span class=\"log-time\">10:42:12</span> <span class=\"log-success\">[LOAD]</span> Upserted 2,403 records into dm_user_metrics</span></div>\n            </div>\n        </div>\n\n        <div class=\"editor-card\" style=\"flex: 0.5;\">\n            <div class=\"editor-header\">\n                <svg class=\"file-icon\" viewBox=\"0 0 24 24\" style=\"fill: var(--accent-teal);\">\n                    <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z\"></path>\n                </svg>\n                <div class=\"file-name\">config.yml (Source Definition)</div>\n            </div>\n            <div class=\"code-content\" style=\"font-size: 11px; padding: 10px;\">\n<span class=\"com\"># Argo Analytics Source Configuration</span>\n<span class=\"kwd\">version</span>: <span class=\"num\">2</span>\n\n<span class=\"kwd\">sources</span>:\n  - <span class=\"kwd\">name</span>: <span class=\"str\">kafka_stream</span>\n    <span class=\"kwd\">description</span>: <span class=\"str\">Real-time user event ingestion via Kafka</span>\n    <span class=\"kwd\">config</span>:\n      <span class=\"kwd\">bootstrap.servers</span>: <span class=\"str\">kafka-cluster.internal:9092</span>\n      <span class=\"kwd\">group.id</span>: <span class=\"str\">argo_analytics_pipeline</span>\n      <span class=\"kwd\">auto.offset.reset</span>: <span class=\"str\">earliest</span>\n      <span class=\"kwd\">schema.registry.url</span>: <span class=\"str\">http://schema-registry:8081</span>\n    \n    <span class=\"kwd\">tables</span>:\n      - <span class=\"kwd\">name</span>: <span class=\"str\">user_events_raw</span>\n        <span class=\"kwd\">topic</span>: <span class=\"str\">user_events</span>\n        <span class=\"kwd\">format</span>: <span class=\"str\">json</span>\n        <span class=\"kwd\">columns</span>:\n          - <span class=\"var\">message_bytes</span> <span class=\"com\"># Binary payload</span>\n          - <span class=\"var\">topic</span> <span class=\"com\"># Metadata</span>\n          - <span class=\"var\">timestamp</span> <span class=\"com\"># Kafka timestamp</span>\n      </div>\n    </div>\n</div>\n\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n        // DOM Elements\n        const tooltip = document.getElementById('tooltip');\n        const ttTitle = document.getElementById('tt-title');\n        const ttDesc = document.getElementById('tt-desc');\n        const ttRate = document.getElementById('tt-rate');\n        const ttStatus = document.getElementById('tt-status');\n        const nodes = document.querySelectorAll('.node');\n        const connections = document.querySelectorAll('.connector');\n        const logPanel = document.getElementById('logPanel');\n\n        // Node Data\n        const nodeData = {\n            'node-source': {\n                title: 'Kafka Cluster Source',\n                desc: 'Ingestion point for real-time streaming data. Consuming from the <strong>user_events</strong> topic using Avro/JSON serialization.',\n                rate: '12,450',\n                status: 'Healthy',\n                color: '#21a8a0'\n            },\n            'node-staging': {\n                title: 'Raw Zone (Staging)',\n                desc: 'Data lake landing zone. Data is written to Delta Lake in Parquet format for cost-efficient storage and schema enforcement.',\n                rate: '12,300',\n                status: 'Active',\n                color: '#f2c94c'\n            },\n            'node-intermediate': {\n                title: 'Cleaned Zone (Intermediate)',\n                desc: 'dbt transformation layer. Handles data cleaning, de-duplication, and enrichment logic before loading the final warehouse.',\n                rate: '11,900',\n                status: 'Optimized',\n                color: '#2fbf71'\n            },\n            'node-bi': {\n                title: 'Analytics Layer (BI)',\n                desc: 'Final Star Schema dimensions and facts. Directly connected to Tableau and Looker Studio for reporting.',\n                rate: '11,850',\n                status: 'Production',\n                color: '#2fbf71'\n            }\n        };\n\n        // Tooltip Logic\n        nodes.forEach(node => {\n            node.addEventListener('mouseenter', (e) => {\n                const id = e.currentTarget.id;\n                const data = nodeData[id];\n                \n                if (data) {\n                    ttTitle.innerText = data.title;\n                    ttTitle.style.color = data.color;\n                    ttDesc.innerHTML = data.desc;\n                    ttRate.innerText = data.rate;\n                    ttStatus.innerText = data.status;\n                    ttStatus.style.color = data.color;\n                    \n                    // Calculate position\n                    const rect = node.getBoundingClientRect();\n                    const canvasRect = document.getElementById('pipelineCanvas').getBoundingClientRect();\n                    \n                    // Center tooltip relative to the node\n                    const x = rect.left - 220; // Position to the left of the node\n                    const y = rect.top - 10;\n\n                    tooltip.style.display = 'block';\n                    tooltip.style.left = `${x}px`;\n                    tooltip.style.top = `${y}px`;\n                }\n            });\n\n            node.addEventListener('mouseleave', () => {\n                tooltip.style.display = 'none';\n            });\n        });\n\n        // Simulate Live Data Flow Animation\n        let activeConnIndex = 0;\n        \n        const animateFlow = () => {\n            // Reset all connections\n            connections.forEach(conn => conn.classList.remove('active'));\n            \n            // Activate current connection\n            if (activeConnIndex < connections.length) {\n                connections[activeConnIndex].classList.add('active');\n                \n                // Update Log based on flow\n                if (activeConnIndex === 0) {\n                    addLogEntry('Kafka', 'Consumed batch of 500 records', 'info');\n                } else if (activeConnIndex === 1) {\n                    addLogEntry('Staging', 'Wrote to Delta Lake (Parquet)', 'success');\n                } else if (activeConnIndex === 2) {\n                    addLogEntry('BI Layer', 'Tableau extract refreshed', 'warn');\n                }\n                \n                activeConnIndex++;\n            } else {\n                activeConnIndex = 0;\n            }\n\n            // Randomize speed slightly for realism\n            setTimeout(animateFlow, Math.random() * 1500 + 1000);\n        };\n\n        // Start animation\n        setTimeout(animateFlow, 1000);\n\n        // Helper to add log entries\n        function addLogEntry(source, message, type) {\n            const now = new Date();\n            const timeString = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}`;\n            \n            const entry = document.createElement('div');\n            entry.className = 'log-entry';\n            \n            let colorClass = 'log-info';\n            if (type === 'warn') colorClass = 'log-warn';\n            if (type === 'success') colorClass = 'log-success';\n\n            entry.innerHTML = `<span class=\"log-time\">${timeString}</span> <span class=\"${colorClass}\">[${source}]</span> ${message}`;\n            \n            logPanel.prepend(entry); // Add to top\n            \n            // Keep log clean (max 10 items)\n            if (logPanel.children.length > 10) {\n                logPanel.lastElementChild.remove();\n            }\n        }\n\n        // Initial Log\n        addLogEntry('SYSTEM', 'Pipeline initialized successfully', 'success');\n        addLogEntry('Kafka', 'Connected to cluster', 'success');\n\n        // Handle Window Resize for Tooltip (Simple re-center logic if needed, but absolute positioning works well here)\n        window.addEventListener('resize', () => {\n            if (tooltip.style.display === 'block') {\n                tooltip.style.display = 'none';\n            }\n        });\n    });\n</script>\n</body>\n</html>", "ms": 49340, "pinned": false}