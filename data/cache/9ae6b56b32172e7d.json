{"node": "ai-ml", "prompt": "Build a dashboard for a model that predicts customer churn for a retail business.", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Argo Analytics | Churn Prediction Dashboard</title>\n    <style>\n        :root {\n            --bg-color: #0b0f14;\n            --card-bg: rgba(255, 255, 255, 0.04);\n            --card-border: rgba(255, 255, 255, 0.08);\n            --text-primary: #e6edf3;\n            --text-muted: #9ba7b4;\n            --accent-green: #2fbf71;\n            --accent-yellow: #f2c94c;\n            --accent-teal: #21a8a0;\n            --grid-line: rgba(255, 255, 255, 0.06);\n            --axis-line: rgba(255, 255, 255, 0.15);\n            --font-main: system-ui, -apple-system, sans-serif;\n        }\n\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        html, body {\n            background: var(--bg-color);\n            color: var(--text-primary);\n            font-family: var(--font-main);\n            height: 100%;\n            width: 100%;\n            overflow-x: hidden;\n        }\n\n        .dashboard-container {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            grid-template-rows: auto auto 1fr;\n            gap: 20px;\n            padding: 20px;\n            height: 100%;\n            width: 100%;\n        }\n\n        /* Header Section */\n        .dashboard-header {\n            grid-column: 1 / -1;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 10px;\n        }\n\n        .branding h1 {\n            font-size: 24px;\n            font-weight: 700;\n            letter-spacing: 0.5px;\n        }\n\n        .branding span {\n            color: var(--accent-teal);\n            font-weight: 400;\n        }\n\n        .timestamp {\n            color: var(--text-muted);\n            font-size: 14px;\n            font-family: monospace;\n        }\n\n        /* KPI Cards */\n        .kpi-card {\n            background: var(--card-bg);\n            border: 1px solid var(--card-border);\n            border-radius: 10px;\n            padding: 20px;\n            display: flex;\n            flex-direction: column;\n            justify-content: space-between;\n            transition: transform 0.2s ease, box-shadow 0.2s ease;\n        }\n\n        .kpi-card:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 8px 24px rgba(0,0,0,0.5);\n            border-color: rgba(255,255,255,0.15);\n        }\n\n        .kpi-label {\n            color: var(--text-muted);\n            font-size: 13px;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            margin-bottom: 8px;\n        }\n\n        .kpi-value {\n            font-size: 36px;\n            font-weight: 700;\n            color: var(--text-primary);\n        }\n\n        .kpi-sub {\n            font-size: 14px;\n            margin-top: 8px;\n            display: flex;\n            align-items: center;\n            gap: 6px;\n        }\n\n        .trend-up { color: var(--accent-green); }\n        .trend-down { color: var(--accent-yellow); }\n\n        /* Main Content Area */\n        .main-content {\n            grid-column: 1 / -1;\n            display: grid;\n            grid-template-columns: 2fr 1fr;\n            gap: 20px;\n            height: 100%;\n            min-height: 400px;\n        }\n\n        /* Chart Container */\n        .chart-container {\n            background: var(--card-bg);\n            border: 1px solid var(--card-border);\n            border-radius: 10px;\n            padding: 24px;\n            display: flex;\n            flex-direction: column;\n        }\n\n        .chart-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 24px;\n        }\n\n        .chart-title {\n            font-size: 18px;\n            font-weight: 600;\n        }\n\n        .chart-subtitle {\n            color: var(--text-muted);\n            font-size: 14px;\n        }\n\n        .svg-wrapper {\n            flex-grow: 1;\n            width: 100%;\n            position: relative;\n        }\n\n        svg {\n            width: 100%;\n            height: 100%;\n            display: block;\n        }\n\n        /* Sidebar / Summary */\n        .sidebar-panel {\n            display: flex;\n            flex-direction: column;\n            gap: 20px;\n        }\n\n        .summary-card {\n            background: var(--card-bg);\n            border: 1px solid var(--card-border);\n            border-radius: 10px;\n            padding: 24px;\n        }\n\n        .summary-title {\n            font-size: 16px;\n            font-weight: 600;\n            margin-bottom: 16px;\n            color: var(--text-primary);\n            border-bottom: 1px solid var(--card-border);\n            padding-bottom: 12px;\n        }\n\n        .summary-text {\n            line-height: 1.6;\n            color: var(--text-muted);\n            font-size: 14px;\n        }\n\n        .highlight-text {\n            color: var(--accent-green);\n            font-weight: 500;\n        }\n\n        .metric-list {\n            list-style: none;\n            margin-top: 16px;\n        }\n\n        .metric-item {\n            display: flex;\n            justify-content: space-between;\n            padding: 10px 0;\n            border-bottom: 1px solid var(--card-border);\n            font-size: 14px;\n        }\n\n        .metric-item:last-child {\n            border-bottom: none;\n        }\n\n        .metric-label { color: var(--text-muted); }\n        .metric-val { font-family: monospace; color: var(--text-primary); }\n\n        /* Bottom Section */\n        .bottom-grid {\n            grid-column: 1 / -1;\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 20px;\n        }\n\n        .mini-card {\n            background: var(--card-bg);\n            border: 1px solid var(--card-border);\n            border-radius: 10px;\n            padding: 20px;\n        }\n\n        .mini-title {\n            font-size: 14px;\n            color: var(--text-muted);\n            margin-bottom: 10px;\n        }\n\n        .mini-value {\n            font-size: 24px;\n            font-weight: 600;\n        }\n\n        .mini-sub {\n            font-size: 12px;\n            color: var(--accent-teal);\n            margin-top: 4px;\n        }\n\n        /* Responsive adjustments */\n        @media (max-width: 1024px) {\n            .main-content { grid-template-columns: 1fr; }\n            .dashboard-container { grid-template-columns: repeat(2, 1fr); }\n            .bottom-grid { grid-template-columns: 1fr; }\n        }\n\n        @media (max-width: 768px) {\n            .dashboard-container { grid-template-columns: 1fr; }\n            .branding h1 { font-size: 18px; }\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"dashboard-container\">\n    <!-- Header -->\n    <div class=\"dashboard-header\">\n        <div class=\"branding\">\n            <h1>Argo Analytics <span>| ChurnGuard Model v4.2</span></h1>\n        </div>\n        <div class=\"timestamp\">\n            LAST UPDATE: <span id=\"clock\">00:00:00</span> | DATA PERIOD: OCT 01 - OCT 30\n        </div>\n    </div>\n\n    <!-- KPI Row -->\n    <div class=\"kpi-card\">\n        <div class=\"kpi-label\">Model Accuracy (AUC-ROC)</div>\n        <div class=\"kpi-value\" style=\"color: var(--accent-green);\">0.94</div>\n        <div class=\"kpi-sub trend-up\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <path d=\"M18 15l-6-6-6 6\"/>\n            </svg>\n            +2.4% vs last month\n        </div>\n    </div>\n\n    <div class=\"kpi-card\">\n        <div class=\"kpi-label\">Precision (Retention Spend)</div>\n        <div class=\"kpi-value\" style=\"color: var(--accent-teal);\">88.5%</div>\n        <div class=\"kpi-sub\">\n            <span style=\"color: var(--text-muted);\">Targeting high-value users</span>\n        </div>\n    </div>\n\n    <div class=\"kpi-card\">\n        <div class=\"kpi-label\">Recall (Churn Caught)</div>\n        <div class=\"kpi-value\" style=\"color: var(--accent-teal);\">82.1%</div>\n        <div class=\"kpi-sub\">\n            <span style=\"color: var(--text-muted);\">Captured 412 at-risk users</span>\n        </div>\n    </div>\n\n    <div class=\"kpi-card\">\n        <div class=\"kpi-label\">Projected Revenue at Risk</div>\n        <div class=\"kpi-value\" style=\"color: var(--accent-yellow);\">$1.24M</div>\n        <div class=\"kpi-sub trend-down\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <path d=\"M6 9l6 6 6-6\"/>\n            </svg>\n            -5% with current intervention\n        </div>\n    </div>\n\n    <!-- Main Content: Charts & Summary -->\n    <div class=\"main-content\">\n        <!-- Left: ROC Curve -->\n        <div class=\"chart-container\">\n            <div class=\"chart-header\">\n                <div>\n                    <div class=\"chart-title\">Receiver Operating Characteristic (ROC)</div>\n                    <div class=\"chart-subtitle\">Model performance vs random classifier</div>\n                </div>\n                <div style=\"font-size: 12px; color: var(--text-muted);\">Threshold: 0.65</div>\n            </div>\n            <div class=\"svg-wrapper\" id=\"roc-chart\">\n                <!-- SVG injected via JS -->\n            </div>\n        </div>\n\n        <!-- Right: Summary Panel -->\n        <div class=\"sidebar-panel\">\n            <div class=\"summary-card\">\n                <div class=\"summary-title\">Model Insights & Analysis</div>\n                <div class=\"summary-text\">\n                    The <strong>Random Forest</strong> model has identified <span class=\"highlight-text\">Payment Failure Frequency</span> as the top predictor of churn (Feature Importance: 0.34).\n                    <br><br>\n                    Users who have experienced more than 2 failed payment attempts in the last 14 days are 5x more likely to churn. The model suggests implementing an automated \"Payment Recovery\" workflow for this segment immediately.\n                    <br><br>\n                    Seasonal trends indicate a spike in churn following major product updates, suggesting a correlation with UI changes in Version 3.0.\n                </div>\n                <ul class=\"metric-list\">\n                    <li class=\"metric-item\">\n                        <span class=\"metric-label\">Top Risk Segment</span>\n                        <span class=\"metric-val\">Free Trial Expiring</span>\n                    </li>\n                    <li class=\"metric-item\">\n                        <span class=\"metric-label\">Avg. Engagement Drop</span>\n                        <span class=\"metric-val\">-45% (30 days pre-churn)</span>\n                    </li>\n                    <li class=\"metric-item\">\n                        <span class=\"metric-label\">Model Confidence</span>\n                        <span class=\"metric-val\" style=\"color: var(--accent-green);\">High (94%)</span>\n                    </li>\n                </ul>\n            </div>\n\n            <div class=\"summary-card\" style=\"flex-grow: 1; display: flex; flex-direction: column;\">\n                <div class=\"summary-title\">Real-time Anomalies</div>\n                <div style=\"overflow-y: auto; flex-grow: 1; padding-right: 5px;\">\n                    <div style=\"display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px; padding: 10px; background: rgba(242, 201, 76, 0.1); border-radius: 6px; border-left: 3px solid var(--accent-yellow);\">\n                        <div style=\"color: var(--accent-yellow);\">!</div>\n                        <div>\n                            <div style=\"color: var(--text-primary); font-weight: 600; font-size: 14px;\">Unusual Support Ticket Volume</div>\n                            <div style=\"color: var(--text-muted); font-size: 13px;\">Group ID: #4921. 15% increase in tickets regarding billing. Churn risk predicted to rise 12% in next 48h.</div>\n                        </div>\n                    </div>\n                    <div style=\"display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px; padding: 10px; background: rgba(47, 191, 113, 0.1); border-radius: 6px; border-left: 3px solid var(--accent-green);\">\n                        <div style=\"color: var(--accent-green);\">\u2713</div>\n                        <div>\n                            <div style=\"color: var(--text-primary); font-weight: 600; font-size: 14px;\">Campaign Success</div>\n                            <div style=\"color: var(--text-muted); font-size: 13px;\">\"SaveOurUsers\" email campaign generated a 22% redemption rate among high-risk targets.</div>\n                        </div>\n                    </div>\n                    <div style=\"display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px; padding: 10px; background: rgba(33, 168, 160, 0.1); border-radius: 6px; border-left: 3px solid var(--accent-teal);\">\n                        <div style=\"color: var(--accent-teal);\">i</div>\n                        <div>\n                            <div style=\"color: var(--text-primary); font-weight: 600; font-size: 14px;\">Data Pipeline Update</div>\n                            <div style=\"color: var(--text-muted); font-size: 13px;\">New CRM integration data ingested successfully. Model retraining scheduled for 02:00 UTC.</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Bottom Row: Feature Importance & Details -->\n    <div class=\"bottom-grid\">\n        <div class=\"mini-card\">\n            <div class=\"mini-title\">Top Feature Drivers</div>\n            <div class=\"mini-value\" style=\"color: var(--accent-green);\">Payment Issues (34%)</div>\n            <div class=\"mini-sub\">Primary Driver</div>\n        </div>\n        <div class=\"mini-card\">\n            <div class=\"mini-title\">Active At-Risk Users</div>\n            <div class=\"mini-value\" style=\"color: var(--accent-yellow);\">1,240</div>\n            <div class=\"mini-sub\">+45 since yesterday</div>\n        </div>\n        <div class=\"mini-card\">\n            <div class=\"mini-title\">Model Latency</div>\n            <div class=\"mini-value\" style=\"color: var(--accent-teal);\">42ms</div>\n            <div class=\"mini-sub\">P99 Response Time</div>\n        </div>\n    </div>\n</div>\n\n<script>\n    // Clock Logic\n    const clockElement = document.getElementById('clock');\n    function updateTime() {\n        const now = new Date();\n        clockElement.textContent = now.toLocaleTimeString('en-US', { hour12: false });\n    }\n    setInterval(updateTime, 1000);\n    updateTime();\n\n    // Chart Data\n    const rocData = [\n        { x: 0, y: 0 },\n        { x: 0.1, y: 0.2 },\n        { x: 0.2, y: 0.35 },\n        { x: 0.3, y: 0.55 },\n        { x: 0.4, y: 0.70 },\n        { x: 0.5, y: 0.82 },\n        { x: 0.6, y: 0.90 },\n        { x: 0.7, y: 0.95 },\n        { x: 0.8, y: 0.97 },\n        { x: 0.9, y: 0.99 },\n        { x: 1, y: 1 }\n    ];\n\n    // Chart Configuration\n    const chartConfig = {\n        width: 800,\n        height: 400,\n        padding: 40,\n        color: '#2fbf71',\n        gridColor: 'rgba(255,255,255,0.06)',\n        axisColor: 'rgba(255,255,255,0.15)',\n        textColor: '#9ba7b4'\n    };\n\n    function renderROCChart() {\n        const container = document.getElementById('roc-chart');\n        const svgNS = \"http://www.w3.org/2000/svg\";\n        const svg = document.createElementNS(svgNS, \"svg\");\n        \n        // Responsive viewBox\n        svg.setAttribute(\"viewBox\", \"0 0 800 400\");\n        svg.setAttribute(\"preserveAspectRatio\", \"none\");\n        svg.style.width = \"100%\";\n        svg.style.height = \"100%\";\n\n        // Gradients\n        const defs = document.createElementNS(svgNS, \"defs\");\n        const gradient = document.createElementNS(svgNS, \"linearGradient\");\n        gradient.id = \"rocGradient\";\n        gradient.setAttribute(\"x1\", \"0\");\n        gradient.setAttribute(\"y1\", \"0\");\n        gradient.setAttribute(\"x2\", \"0\");\n        gradient.setAttribute(\"y2\", \"1\");\n\n        const stop1 = document.createElementNS(svgNS, \"stop\");\n        stop1.setAttribute(\"offset\", \"0%\");\n        stop1.setAttribute(\"stop-color\", \"#2fbf71\");\n        stop1.setAttribute(\"stop-opacity\", \"0.3\");\n\n        const stop2 = document.createElementNS(svgNS, \"stop\");\n        stop2.setAttribute(\"offset\", \"100%\");\n        stop2.setAttribute(\"stop-color\", \"#2fbf71\");\n        stop2.setAttribute(\"stop-opacity\", \"0\");\n\n        gradient.appendChild(stop1);\n        gradient.appendChild(stop2);\n        defs.appendChild(gradient);\n        svg.appendChild(defs);\n\n        // Calculate scales\n        const w = chartConfig.width;\n        const h = chartConfig.height;\n        const p = chartConfig.padding;\n        const chartW = w - (p * 2);\n        const chartH = h - (p * 2);\n\n        // Helper to map data to coords\n        const getX = (x) => p + (x * chartW);\n        const getY = (y) => h - p - (y * chartH);\n\n        // Group for chart content\n        const g = document.createElementNS(svgNS, \"g\");\n        g.setAttribute(\"transform\", `translate(0,0)`);\n\n        // 1. Grid Lines\n        // Y-axis grid\n        for(let i=0; i<=1; i+=0.2) {\n            const y = getY(i);\n            const line = document.createElementNS(svgNS, \"line\");\n            line.setAttribute(\"x1\", p);\n            line.setAttribute(\"y1\", y);\n            line.setAttribute(\"x2\", w - p);\n            line.setAttribute(\"y2\", y);\n            line.setAttribute(\"stroke\", chartConfig.gridColor);\n            line.setAttribute(\"stroke-width\", \"1\");\n            g.appendChild(line);\n\n            // Labels\n            const text = document.createElementNS(svgNS, \"text\");\n            text.setAttribute(\"x\", p - 10);\n            text.setAttribute(\"y\", y + 4);\n            text.setAttribute(\"text-anchor\", \"end\");\n            text.setAttribute(\"font-size\", \"12\");\n            text.setAttribute(\"fill\", chartConfig.textColor);\n            text.textContent = i.toFixed(1);\n            g.appendChild(text);\n        }\n\n        // X-axis grid\n        for(let i=0; i<=1; i+=0.2) {\n            const x = getX(i);\n            const line = document.createElementNS(svgNS, \"line\");\n            line.setAttribute(\"x1\", x);\n            line.setAttribute(\"y1\", h - p);\n            line.setAttribute(\"x2\", x);\n            line.setAttribute(\"y2\", p);\n            line.setAttribute(\"stroke\", chartConfig.gridColor);\n            line.setAttribute(\"stroke-width\", \"1\");\n            g.appendChild(line);\n\n            // Labels\n            const text = document.createElementNS(svgNS, \"text\");\n            text.setAttribute(\"x\", x);\n            text.setAttribute(\"y\", h - p + 20);\n            text.setAttribute(\"text-anchor\", \"middle\");\n            text.setAttribute(\"font-size\", \"12\");\n            text.setAttribute(\"fill\", chartConfig.textColor);\n            text.textContent = i.toFixed(1);\n            g.appendChild(text);\n        }\n\n        // 2. Axis Lines (Main Borders)\n        const axisX = document.createElementNS(svgNS, \"line\");\n        axisX.setAttribute(\"x1\", p);\n        axisX.setAttribute(\"y1\", h - p);\n        axisX.setAttribute(\"x2\", w - p);\n        axisX.setAttribute(\"y2\", h - p);\n        axisX.setAttribute(\"stroke\", chartConfig.axisColor);\n        axisX.setAttribute(\"stroke-width\", \"2\");\n        g.appendChild(axisX);\n\n        const axisY = document.createElementNS(svgNS, \"line\");\n        axisY.setAttribute(\"x1\", p);\n        axisY.setAttribute(\"y1\", p);\n        axisY.setAttribute(\"x2\", p);\n        axisY.setAttribute(\"y2\", h - p);\n        axisY.setAttribute(\"stroke\", chartConfig.axisColor);\n        axisY.setAttribute(\"stroke-width\", \"2\");\n        g.appendChild(axisY);\n\n        // 3. Random Classifier Line (Diagonal)\n        const diagLine = document.createElementNS(svgNS, \"line\");\n        diagLine.setAttribute(\"x1\", p);\n        diagLine.setAttribute(\"y1\", h - p);\n        diagLine.setAttribute(\"x2\", w - p);\n        diagLine.setAttribute(\"y2\", p);\n        diagLine.setAttribute(\"stroke\", chartConfig.gridColor);\n        diagLine.setAttribute(\"stroke-width\", \"1\");\n        diagLine.setAttribute(\"stroke-dasharray\", \"5,5\");\n        g.appendChild(diagLine);\n\n        // 4. Model Curve (Area + Line)\n        // Create Path for Area\n        let areaPathD = `M ${getX(0)} ${h - p} `; // Start bottom left\n        rocData.forEach(d => {\n            areaPathD += `L ${getX(d.x)} ${getY(d.y)} `;\n        });\n        areaPathD += `L ${getX(1)} ${h - p} Z`; // Close bottom right\n\n        const areaPath = document.createElementNS(svgNS, \"path\");\n        areaPath.setAttribute(\"d\", areaPathD);\n        areaPath.setAttribute(\"fill\", \"url(#rocGradient)\");\n        g.appendChild(areaPath);\n\n        // Create Path for Line\n        let linePathD = `M ${getX(0)} ${h - p} `;\n        rocData.forEach((d, index) => {\n            if(index === 0) return;\n            linePathD += `L ${getX(d.x)} ${getY(d.y)} `;\n        });\n\n        const linePath = document.createElementNS(svgNS, \"path\");\n        linePath.setAttribute(\"d\", linePathD);\n        linePath.setAttribute(\"fill\", \"none\");\n        linePath.setAttribute(\"stroke\", chartConfig.color);\n        linePath.setAttribute(\"stroke-width\", \"4\");\n        linePath.setAttribute(\"stroke-linecap\", \"round\");\n        linePath.setAttribute(\"stroke-linejoin\", \"round\");\n        g.appendChild(linePath);\n\n        // 5. Labels\n        const yLabel = document.createElementNS(svgNS, \"text\");\n        yLabel.setAttribute(\"x\", 15);\n        yLabel.setAttribute(\"y\", 20);\n        yLabel.setAttribute(\"font-size\", \"14\");\n        yLabel.setAttribute(\"fill\", chartConfig.textColor);\n        yLabel.setAttribute(\"font-weight\", \"bold\");\n        yLabel.textContent = \"True Positive Rate\";\n        g.appendChild(yLabel);\n\n        const xLabel = document.createElementNS(svgNS, \"text\");\n        xLabel.setAttribute(\"x\", w - 20);\n        xLabel.setAttribute(\"y\", h - 5);\n        xLabel.setAttribute(\"font-size\", \"14\");\n        xLabel.setAttribute(\"fill\", chartConfig.textColor);\n        xLabel.setAttribute(\"text-anchor\", \"end\");\n        xLabel.textContent = \"False Positive Rate\";\n        g.appendChild(xLabel);\n\n        const aucBadge = document.createElementNS(svgNS, \"g\");\n        const badgeRect = document.createElementNS(svgNS, \"rect\");\n        badgeRect.setAttribute(\"x\", w - 160);\n        badgeRect.setAttribute(\"y\", 30);\n        badgeRect.setAttribute(\"width\", 130);\n        badgeRect.setAttribute(\"height\", 40);\n        badgeRect.setAttribute(\"rx\", 6);\n        badgeRect.setAttribute(\"fill\", \"rgba(11, 15, 20, 0.8)\");\n        badgeRect.setAttribute(\"stroke\", \"rgba(255,255,255,0.1)\");\n        \n        const badgeText1 = document.createElementNS(svgNS, \"text\");\n        badgeText1.setAttribute(\"x\", w - 145);\n        badgeText1.setAttribute(\"y\", 55);\n        badgeText1.setAttribute(\"font-size\", \"12\");\n        badgeText1.setAttribute(\"fill\", chartConfig.textColor);\n        badgeText1.textContent = \"Model AUC Score\";\n\n        const badgeText2 = document.createElementNS(svgNS, \"text\");\n        badgeText2.setAttribute(\"x\", w - 145);\n        badgeText2.setAttribute(\"y\", 72);\n        badgeText2.setAttribute(\"font-size\", \"20\");\n        badgeText2.setAttribute(\"font-weight\", \"bold\");\n        badgeText2.setAttribute(\"fill\", chartConfig.color);\n        badgeText2.textContent = \"0.94\";\n\n        aucBadge.appendChild(badgeRect);\n        aucBadge.appendChild(badgeText1);\n        aucBadge.appendChild(badgeText2);\n        g.appendChild(aucBadge);\n\n        svg.appendChild(g);\n        container.appendChild(svg);\n    }\n\n    // Initialize Charts\n    renderROCChart();\n\n    // Add a subtle animation to the ROC line on load\n    window.addEventListener('load', () => {\n        const line = document.querySelector('path[stroke=\"#2fbf71\"]');\n        if(line) {\n            const length = line.getTotalLength();\n            line.style.strokeDasharray = length;\n            line.style.strokeDashoffset = length;\n            line.style.transition = \"stroke-dashoffset 2s ease-in-out\";\n            requestAnimationFrame(() => {\n                line.style.strokeDashoffset = 0;\n            });\n        }\n    });\n\n</script>\n</body>\n</html>", "ms": 47798, "pinned": true}