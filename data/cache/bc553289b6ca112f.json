{"node": "data-engineering", "prompt": "Add incremental loading and error handling to the pipeline and annotate the lineage.", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Argo Analytics Pipeline | Enhanced Lineage</title>\n    <style>\n        :root {\n            --bg-color: #0b0f14;\n            --card-bg: rgba(255, 255, 255, 0.04);\n            --border-color: rgba(255, 255, 255, 0.08);\n            --text-primary: #e6edf3;\n            --text-muted: #9ba7b4;\n            --accent-green: #2fbf71;\n            --accent-teal: #21a8a0;\n            --accent-yellow: #f2c94c;\n            --accent-red: #ff5b5b;\n            --font-main: system-ui, -apple-system, sans-serif;\n        }\n\n        * {\n            box-sizing: border-box;\n        }\n\n        html, body {\n            margin: 0;\n            padding: 0;\n            background: var(--bg-color);\n            color: var(--text-primary);\n            font-family: var(--font-main);\n            height: 100%;\n            overflow: hidden;\n        }\n\n        .container {\n            display: flex;\n            height: 100vh;\n            width: 100vw;\n            padding: 20px;\n            gap: 20px;\n        }\n\n        /* Left Column: Pipeline Visualization */\n        .pipeline-section {\n            flex: 5.5;\n            display: flex;\n            flex-direction: column;\n            background: var(--card-bg);\n            border: 1px solid var(--border-color);\n            border-radius: 10px;\n            padding: 16px;\n            box-shadow: 0 4px 24px rgba(0,0,0,0.4);\n            position: relative;\n        }\n\n        .section-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 20px;\n            padding-bottom: 10px;\n            border-bottom: 1px solid var(--border-color);\n        }\n\n        .section-title {\n            font-size: 18px;\n            font-weight: 600;\n            color: var(--text-primary);\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n\n        .status-indicator {\n            width: 8px;\n            height: 8px;\n            border-radius: 50%;\n            background-color: var(--accent-green);\n            box-shadow: 0 0 8px var(--accent-green);\n            animation: pulse 2s infinite;\n        }\n\n        @keyframes pulse {\n            0% { opacity: 1; }\n            50% { opacity: 0.6; }\n            100% { opacity: 1; }\n        }\n\n        .pipeline-viewport {\n            flex: 1;\n            position: relative;\n            overflow-x: auto;\n            overflow-y: auto;\n            background: radial-gradient(circle at center, #131a23 0%, #0b0f14 100%);\n            border-radius: 8px;\n            border: 1px solid rgba(0,0,0,0.2);\n            padding: 40px 0;\n        }\n\n        /* SVG Connectors */\n        svg.connector-layer {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            z-index: 1;\n        }\n\n        .connector-line {\n            fill: none;\n            stroke: rgba(255,255,255,0.15);\n            stroke-width: 2;\n            stroke-dasharray: 10;\n            transition: stroke 0.3s ease;\n        }\n\n        .connector-line.active {\n            stroke: var(--accent-green);\n            stroke-dasharray: 0;\n            animation: flow 2s linear infinite;\n        }\n\n        @keyframes flow {\n            to { stroke-dashoffset: -20; }\n        }\n\n        /* Pipeline Nodes */\n        .pipeline-node {\n            position: absolute;\n            width: 220px;\n            background: rgba(16, 22, 30, 0.95);\n            border: 1px solid var(--border-color);\n            border-radius: 8px;\n            padding: 16px;\n            z-index: 2;\n            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s;\n            cursor: pointer;\n        }\n\n        .pipeline-node:hover {\n            transform: translateY(-2px);\n            border-color: var(--accent-teal);\n            box-shadow: 0 8px 24px rgba(0,0,0,0.5);\n        }\n\n        .node-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 12px;\n            border-bottom: 1px solid rgba(255,255,255,0.05);\n            padding-bottom: 8px;\n        }\n\n        .node-title {\n            font-weight: 600;\n            color: var(--text-primary);\n            font-size: 16px;\n        }\n\n        .node-icon {\n            width: 32px;\n            height: 32px;\n            background: rgba(255,255,255,0.05);\n            border-radius: 6px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: var(--accent-teal);\n        }\n\n        .node-meta {\n            display: flex;\n            flex-direction: column;\n            gap: 6px;\n        }\n\n        .meta-row {\n            display: flex;\n            justify-content: space-between;\n            font-size: 12px;\n            color: var(--text-muted);\n        }\n\n        .meta-value {\n            color: var(--text-primary);\n            font-family: monospace;\n        }\n\n        .node-status {\n            margin-top: 10px;\n            font-size: 11px;\n            padding: 4px 8px;\n            border-radius: 4px;\n            display: inline-block;\n            width: fit-content;\n        }\n\n        .status-success { background: rgba(47, 191, 113, 0.15); color: var(--accent-green); border: 1px solid rgba(47, 191, 113, 0.3); }\n        .status-running { background: rgba(33, 168, 160, 0.15); color: var(--accent-teal); border: 1px solid rgba(33, 168, 160, 0.3); }\n        .status-error { background: rgba(255, 91, 91, 0.15); color: var(--accent-red); border: 1px solid rgba(255, 91, 91, 0.3); }\n\n        /* Tooltip */\n        .tooltip {\n            position: absolute;\n            background: rgba(11, 15, 20, 0.95);\n            border: 1px solid var(--border-color);\n            padding: 12px;\n            border-radius: 6px;\n            width: 240px;\n            z-index: 100;\n            font-size: 12px;\n            pointer-events: none;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.6);\n            opacity: 0;\n            transition: opacity 0.2s ease;\n            backdrop-filter: blur(4px);\n        }\n\n        .tooltip h4 {\n            margin: 0 0 8px 0;\n            color: var(--accent-green);\n            font-size: 13px;\n            border-bottom: 1px solid var(--border-color);\n            padding-bottom: 4px;\n        }\n\n        .tooltip p {\n            margin: 4px 0;\n            color: var(--text-muted);\n            line-height: 1.4;\n        }\n\n        .tooltip strong {\n            color: var(--text-primary);\n        }\n\n        /* Right Column: Code & Logs */\n        .code-section {\n            flex: 4.5;\n            display: flex;\n            flex-direction: column;\n            background: var(--card-bg);\n            border: 1px solid var(--border-color);\n            border-radius: 10px;\n            padding: 0;\n            box-shadow: 0 4px 24px rgba(0,0,0,0.4);\n            overflow: hidden;\n        }\n\n        .code-header {\n            padding: 16px;\n            background: rgba(0,0,0,0.2);\n            border-bottom: 1px solid var(--border-color);\n            display: flex;\n            gap: 10px;\n        }\n\n        .file-tab {\n            padding: 8px 16px;\n            background: var(--bg-color);\n            border-top: 2px solid var(--accent-teal);\n            color: var(--text-primary);\n            font-size: 13px;\n            font-weight: 500;\n            border-radius: 6px 6px 0 0;\n        }\n\n        .code-content {\n            flex: 1;\n            overflow: auto;\n            padding: 0;\n            font-family: 'Fira Code', 'Consolas', 'Monaco', monospace;\n            font-size: 13px;\n            line-height: 1.6;\n            color: #dce2e9;\n            white-space: pre;\n        }\n\n        .line-numbers {\n            float: left;\n            padding: 16px;\n            text-align: right;\n            color: var(--text-muted);\n            background: rgba(0,0,0,0.2);\n            user-select: none;\n            border-right: 1px solid var(--border-color);\n        }\n\n        .code-body {\n            padding: 16px;\n            padding-left: 10px;\n        }\n\n        /* Syntax Highlighting Classes */\n        .kwd { color: #c678dd; } /* Keyword */\n        .str { color: #98c379; } /* String */\n        .num { color: #d19a66; } /* Number */\n        .fun { color: #61afef; } /* Function */\n        .com { color: #5c6370; font-style: italic; } /* Comment */\n        .var { color: #e06c75; } /* Variable */\n\n        /* Logs Panel */\n        .logs-panel {\n            height: 250px;\n            background: #0d1117;\n            border-top: 1px solid var(--border-color);\n            padding: 0;\n            display: flex;\n            flex-direction: column;\n        }\n\n        .logs-header {\n            padding: 8px 16px;\n            font-size: 12px;\n            font-weight: 600;\n            color: var(--text-muted);\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            background: rgba(0,0,0,0.3);\n            border-bottom: 1px solid var(--border-color);\n            display: flex;\n            justify-content: space-between;\n        }\n\n        .log-stream {\n            flex: 1;\n            overflow-y: auto;\n            padding: 10px;\n            font-family: 'Fira Code', monospace;\n            font-size: 12px;\n        }\n\n        .log-entry {\n            margin-bottom: 6px;\n            padding: 4px 8px;\n            border-radius: 4px;\n            animation: fadeIn 0.3s ease;\n        }\n\n        .log-info { border-left: 3px solid var(--accent-teal); background: rgba(33, 168, 160, 0.1); }\n        .log-warn { border-left: 3px solid var(--accent-yellow); background: rgba(242, 201, 76, 0.1); }\n        .log-error { border-left: 3px solid var(--accent-red); background: rgba(255, 91, 91, 0.1); color: #ffb3b3; }\n        .log-success { border-left: 3px solid var(--accent-green); background: rgba(47, 191, 113, 0.1); }\n\n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateX(-5px); }\n            to { opacity: 1; transform: translateX(0); }\n        }\n\n        /* Responsive adjustments */\n        @media (max-width: 1000px) {\n            .container { flex-direction: column; overflow-y: auto; }\n            .pipeline-section, .code-section { flex: none; width: 100%; height: auto; }\n            .code-section { min-height: 500px; }\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"container\">\n    <!-- Left Column: Interactive Pipeline -->\n    <section class=\"pipeline-section\">\n        <div class=\"section-header\">\n            <div class=\"section-title\">\n                <div class=\"status-indicator\" id=\"globalStatus\"></div>\n                Data Lineage & Processing Graph\n            </div>\n            <div style=\"font-size: 12px; color: var(--text-muted);\">\n                <span style=\"margin-right: 10px;\">Last Run: 2m ago</span>\n                <span id=\"lastRunTime\">2023-10-27 14:02:11</span>\n            </div>\n        </div>\n\n        <div class=\"pipeline-viewport\" id=\"pipelineContainer\">\n            <!-- SVG Layer for Lines -->\n            <svg class=\"connector-layer\" id=\"svgLayer\">\n                <defs>\n                    <marker id=\"arrowhead\" markerWidth=\"10\" markerHeight=\"7\" refX=\"9\" refY=\"3.5\" orient=\"auto\">\n                        <polygon points=\"0 0, 10 3.5, 0 7\" fill=\"rgba(255,255,255,0.2)\" />\n                    </marker>\n                </defs>\n                <!-- Lines will be generated by JS -->\n            </svg>\n\n            <!-- Source Node -->\n            <div class=\"pipeline-node\" id=\"node-source\" style=\"top: 50%; left: 50px;\" data-stage=\"source\">\n                <div class=\"node-header\">\n                    <div class=\"node-title\">Raw Source</div>\n                    <div class=\"node-icon\">\u2601\ufe0f</div>\n                </div>\n                <div class=\"node-meta\">\n                    <div class=\"meta-row\"><span>Table</span><span class=\"meta-value\">web_events_raw</span></div>\n                    <div class=\"meta-row\"><span>Rows</span><span class=\"meta-value\">2.4M</span></div>\n                    <div class=\"meta-row\"><span>Size</span><span class=\"meta-value\">450 MB</span></div>\n                    <div class=\"meta-row\"><span>Latency</span><span class=\"meta-value\">Real-time</span></div>\n                </div>\n                <div class=\"node-status status-success\">Synced</div>\n            </div>\n\n            <!-- Staging Node -->\n            <div class=\"pipeline-node\" id=\"node-staging\" style=\"top: 30%; left: 400px;\" data-stage=\"staging\">\n                <div class=\"node-header\">\n                    <div class=\"node-title\">Staging Layer</div>\n                    <div class=\"node-icon\">\ud83d\udce6</div>\n                </div>\n                <div class=\"node-meta\">\n                    <div class=\"meta-row\"><span>Table</span><span class=\"meta-value\">stg_events_cleaned</span></div>\n                    <div class=\"meta-row\"><span>Rows</span><span class=\"meta-value\">2.38M</span></div>\n                    <div class=\"meta-row\"><span>Nulls</span><span class=\"meta-value\">0.8%</span></div>\n                    <div class=\"meta-row\"><span>Schema</span><span class=\"meta-value\">14 Columns</span></div>\n                </div>\n                <div class=\"node-status status-success\">Validated</div>\n            </div>\n\n            <!-- Intermediate Node -->\n            <div class=\"pipeline-node\" id=\"node-intermediate\" style=\"top: 60%; left: 400px;\" data-stage=\"intermediate\">\n                <div class=\"node-header\">\n                    <div class=\"node-title\">Intermediate Agg</div>\n                    <div class=\"node-icon\">\u2699\ufe0f</div>\n                </div>\n                <div class=\"node-meta\">\n                    <div class=\"meta-row\"><span>Table</span><span class=\"meta-value\">intm_user_sessions</span></div>\n                    <div class=\"meta-row\"><span>Rows</span><span class=\"meta-value\">845k</span></div>\n                    <div class=\"meta-row\"><span>Method</span><span class=\"meta-value\">Incremental</span></div>\n                    <div class=\"meta-row\"><span>Window</span><span class=\"meta-value\">24 hrs</span></div>\n                </div>\n                <div class=\"node-status status-success\">Up to Date</div>\n            </div>\n\n            <!-- BI Node -->\n            <div class=\"pipeline-node\" id=\"node-bi\" style=\"top: 45%; left: 750px;\" data-stage=\"bi\">\n                <div class=\"node-header\">\n                    <div class=\"node-title\">BI Model</div>\n                    <div class=\"node-icon\">\ud83d\udcca</div>\n                </div>\n                <div class=\"node-meta\">\n                    <div class=\"meta-row\"><span>View</span><span class=\"meta-value\">fct_daily_analytics</span></div>\n                    <div class=\"meta-row\"><span>Rows</span><span class=\"meta-value\">12.5k</span></div>\n                    <div class=\"meta-row\"><span>Refresh</span><span class=\"meta-value\">Daily</span></div>\n                    <div class=\"meta-row\"><span>Consumers</span><span class=\"meta-value\">3 Dashboards</span></div>\n                </div>\n                <div class=\"node-status status-success\">Ready</div>\n            </div>\n\n            <!-- Error Node (Hidden initially) -->\n            <div class=\"pipeline-node\" id=\"node-error\" style=\"top: 80%; left: 400px; border-color: var(--accent-red);\" data-stage=\"error\">\n                <div class=\"node-header\">\n                    <div class=\"node-title\" style=\"color: var(--accent-red);\">Retry Queue</div>\n                    <div class=\"node-icon\" style=\"color: var(--accent-red);\">\u26a0\ufe0f</div>\n                </div>\n                <div class=\"node-meta\">\n                    <div class=\"meta-row\"><span>Failed Rows</span><span class=\"meta-value\" style=\"color: var(--accent-red);\">1,204</span></div>\n                    <div class=\"meta-row\"><span>Error Code</span><span class=\"meta-value\" style=\"color: var(--accent-red);\">E-409</span></div>\n                    <div class=\"meta-row\"><span>Retry Count</span><span class=\"meta-value\">3/5</span></div>\n                </div>\n                <div class=\"node-status status-error\">Paused (Manual Review)</div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Right Column: Code & Logs -->\n    <section class=\"code-section\">\n        <div class=\"code-header\">\n            <div class=\"file-tab\">models/fct_daily_analytics.sql</div>\n            <div class=\"file-tab\" style=\"border-top: 2px solid var(--text-muted);\">logs/stream.log</div>\n        </div>\n\n        <div class=\"code-content\">\n            <div class=\"line-numbers\">\n                1<br>2<br>3<br>4<br>5<br>6<br>7<br>8<br>9<br>10<br>11<br>12<br>13<br>14<br>15<br>16<br>17<br>18<br>19<br>20<br>21<br>22<br>23<br>24<br>25<br>26<br>27<br>28<br>29<br>30<br>31<br>32<br>33<br>34\n            </div>\n            <div class=\"code-body\">\n<span class=\"com\"># {{ config(materialized='incremental', unique_key='session_id') }}</span>\n<span class=\"kwd\">WITH</span> <span class=\"var\">raw_data</span> <span class=\"kwd\">AS</span> (\n    <span class=\"kwd\">SELECT</span> * <span class=\"kwd\">FROM</span> <span class=\"var\">{{ ref('stg_events_cleaned') }}</span>\n    <span class=\"kwd\">WHERE</span> <span class=\"var\">event_timestamp</span> <span class=\"kwd\">>=</span> <span class=\"fun\">get_start_date()</span>\n    {% <span class=\"kwd\">if</span> is_incremental() %}\n      <span class=\"com\"># Incremental filter: only new data since last run</span>\n      <span class=\"kwd\">AND</span> <span class=\"var\">event_timestamp</span> <span class=\"kwd\">>=</span> ( <span class=\"kwd\">SELECT</span> MAX(date_day) <span class=\"kwd\">FROM</span> <span class=\"var\">{{ this }}</span> )\n    {% <span class=\"kwd\">endif</span> %}\n),\n\n<span class=\"var\">sessionized</span> <span class=\"kwd\">AS</span> (\n    <span class=\"kwd\">SELECT</span>\n        <span class=\"var\">user_id</span>,\n        <span class=\"fun\">DATE_TRUNC</span>(<span class=\"str\">'day'</span>, <span class=\"var\">event_timestamp</span>) <span class=\"kwd\">AS</span> <span class=\"var\">date_day</span>,\n        <span class=\"fun\">COUNT</span>(<span class=\"kwd\">*</span>) <span class=\"kwd\">AS</span> <span class=\"var\">total_events</span>,\n        <span class=\"fun\">SUM</span>(<span class=\"var\">session_duration</span>) <span class=\"kwd\">AS</span> <span class=\"var\">total_duration_s</span>\n    <span class=\"kwd\">FROM</span> <span class=\"var\">raw_data</span>\n    <span class=\"kwd\">WHERE</span> <span class=\"var\">event_type</span> <span class=\"kwd\">IN</span> (<span class=\"str\">'page_view'</span>, <span class=\"str\">'click'</span>)\n    <span class=\"kwd\">GROUP BY</span> <span class=\"kwd\">ALL</span>\n),\n\n<span class=\"var\">error_handling</span> <span class=\"kwd\">AS</span> (\n    <span class=\"com\"># Handle nulls and outliers</span>\n    <span class=\"kwd\">SELECT</span>\n        <span class=\"kwd\">*</span>,\n        <span class=\"fun\">COALESCE</span>(<span class=\"var\">total_duration_s</span>, <span class=\"num\">0</span>) <span class=\"kwd\">AS</span> <span class=\"var\">clean_duration</span>,\n        <span class=\"com\"># Soft fail logic for bad data</span>\n        <span class=\"kwd\">CASE</span> \n            <span class=\"kwd\">WHEN</span> <span class=\"var\">total_events</span> <span class=\"kwd\">=</span> <span class=\"num\">0</span> <span class=\"kwd\">THEN</span> <span class=\"str\">'invalid'</span>\n            <span class=\"kwd\">ELSE</span> <span class=\"str\">'valid'</span>\n        <span class=\"kwd\">END</span> <span class=\"kwd\">AS</span> <span class=\"var\">data_quality_flag</span>\n    <span class=\"kwd\">FROM</span> <span class=\"var\">sessionized</span>\n)\n\n<span class=\"kwd\">SELECT</span> * <span class=\"kwd\">FROM</span> <span class=\"var\">error_handling</span>\n            </div>\n        </div>\n\n        <div class=\"logs-panel\">\n            <div class=\"logs-header\">\n                <span>Execution Log</span>\n                <span id=\"logCount\">14 entries</span>\n            </div>\n            <div class=\"log-stream\" id=\"logStream\">\n                <div class=\"log-entry log-info\">[14:02:00] Pipeline execution initiated...</div>\n                <div class=\"log-entry log-info\">[14:02:01] Connecting to Snowflake Source...</div>\n                <div class=\"log-entry log-success\">[14:02:05] Source table locked (Snapshot: 2.4M rows fetched).</div>\n                <div class=\"log-entry log-info\">[14:02:06] Starting Staging Transformation...</div>\n                <div class=\"log-entry log-warn\">[14:02:08] Warning: Found 1,204 rows with NULL user_id. Flagging for quarantine.</div>\n                <div class=\"log-entry log-success\">[14:02:10] Staging validated. 99.92% data integrity score.</div>\n                <div class=\"log-entry log-info\">[14:02:11] Incremental Check: Last run was 2023-10-27 14:00:00.</div>\n                <div class=\"log-entry log-info\">[14:02:12] Processing 45,200 new events...</div>\n                <div class=\"log-entry log-error\">[14:02:15] ERROR: Duplicate key violation in 'intm_user_sessions'. Session ID: sess_99821 found twice.</div>\n                <div class=\"log-entry log-warn\">[14:02:16] Rolling back transaction to savepoint.</div>\n                <div class=\"log-entry log-info\">[14:02:17] Switching to Error Handling Mode...</div>\n                <div class=\"log-entry log-success\">[14:02:18] 1,204 problematic rows moved to 'retry_queue' table.</div>\n                <div class=\"log-entry log-info\">[14:02:19] Resuming Main Pipeline...</div>\n                <div class=\"log-entry log-success\">[14:02:25] BI Model 'fct_daily_analytics' updated successfully.</div>\n                <div class=\"log-entry log-success\">[14:02:26] Notification sent to Slack #data-alerts.</div>\n            </div>\n        </div>\n    </section>\n</div>\n\n<div class=\"tooltip\" id=\"tooltip\">\n    <h4 id=\"ttTitle\">Node Title</h4>\n    <p id=\"ttDesc\">Description goes here.</p>\n    <hr style=\"border: 0; border-top: 1px solid var(--border-color); margin: 8px 0;\">\n    <p style=\"margin: 0; font-size: 11px; color: var(--text-muted);\">\n        <strong>Details:</strong> <span id=\"ttDetails\"></span>\n    </p>\n</div>\n\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n        const pipelineContainer = document.getElementById('pipelineContainer');\n        const svgLayer = document.getElementById('svgLayer');\n        const tooltip = document.getElementById('tooltip');\n        const logStream = document.getElementById('logStream');\n        const globalStatus = document.getElementById('globalStatus');\n        \n        // Configuration for nodes (absolute positions relative to container)\n        const nodes = [\n            { id: 'node-source', label: 'Source System', desc: 'Raw ingestion point. Data comes from Mixpanel and Firebase.', details: 'Latency: <5s | Format: JSON' },\n            { id: 'node-staging', label: 'Staging Layer', desc: 'Data cleaning and validation. Handles schema evolution and null checks.', details: 'Strategy: Overwrite | Quality: 99.92%' },\n            { id: 'node-intermediate', label: 'Intermediate Aggregation', desc: 'Sessionization logic. Groups events by user and day.', details: 'Method: Incremental | Key: session_id' },\n            { id: 'node-bi', label: 'BI Model', desc: 'Final fact table for dashboards. Pre-joined for performance.', details: 'Consumers: 3 Dashboards | Size: Small' },\n            { id: 'node-error', label: 'Error Queue', desc: 'Holds failed records due to duplicate keys or constraint violations.', details: 'Action Required: Manual Review' }\n        ];\n\n        // 1. Draw Connectors\n        function drawConnectors() {\n            const source = document.getElementById('node-source');\n            const staging = document.getElementById('node-staging');\n            const intermediate = document.getElementById('node-intermediate');\n            const bi = document.getElementById('node-bi');\n            const error = document.getElementById('node-error');\n\n            const createLine = (el1, el2, color = 'rgba(255,255,255,0.15)', active = false) => {\n                const rect1 = el1.getBoundingClientRect();\n                const rect2 = el2.getBoundingClientRect();\n                const containerRect = pipelineContainer.getBoundingClientRect();\n\n                // Calculate relative coordinates\n                const x1 = rect1.right - containerRect.left;\n                const y1 = rect1.top + (rect1.height / 2) - containerRect.top;\n                const x2 = rect2.left - containerRect.left;\n                const y2 = rect2.top + (rect2.height / 2) - containerRect.top;\n\n                const line = document.createElementNS('http://www.w3.org/2000/svg', 'path');\n                \n                // Bezier curve logic\n                const cp1x = x1 + (x2 - x1) * 0.5;\n                const cp1y = y1;\n                const cp2x = x1 + (x2 - x1) * 0.5;\n                const cp2y = y2;\n                \n                const d = `M ${x1} ${y1} C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${x2} ${y2}`;\n                \n                line.setAttribute('d', d);\n                line.setAttribute('stroke', color);\n                line.setAttribute('stroke-width', '2');\n                line.setAttribute('fill', 'none');\n                line.setAttribute('marker-end', 'url(#arrowhead)');\n                \n                if (active) {\n                    line.classList.add('active');\n                    line.setAttribute('stroke', '#2fbf71');\n                }\n                \n                svgLayer.appendChild(line);\n            };\n\n            // Standard Flow\n            drawLine(source, staging);\n            drawLine(staging, intermediate);\n            drawLine(intermediate, bi);\n            \n            // Error Flow (Staging -> Error Queue)\n            drawLine(staging, error, 'rgba(255, 91, 91, 0.3)');\n        }\n\n        // Helper to handle coordinate recalculation on resize\n        function drawLine(el1, el2, color = 'rgba(255,255,255,0.15)', active = false) {\n            const rect1 = el1.getBoundingClientRect();\n            const rect2 = el2.getBoundingClientRect();\n            const containerRect = pipelineContainer.getBoundingClientRect();\n\n            const x1 = rect1.right - containerRect.left;\n            const y1 = rect1.top + (rect1.height / 2) - containerRect.top;\n            const x2 = rect2.left - containerRect.left;\n            const y2 = rect2.top + (rect2.height / 2) - containerRect.top;\n\n            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');\n            const cp1x = x1 + (x2 - x1) * 0.4;\n            const cp1y = y1;\n            const cp2x = x2 - (x2 - x1) * 0.4;\n            const cp2y = y2;\n\n            const d = `M ${x1} ${y1} C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${x2} ${y2}`;\n            \n            path.setAttribute('d', d);\n            path.setAttribute('stroke', color);\n            path.setAttribute('stroke-width', '2');\n            path.setAttribute('fill', 'none');\n            path.setAttribute('marker-end', 'url(#arrowhead)');\n            \n            if (active) {\n                path.classList.add('active');\n                path.setAttribute('stroke', '#2fbf71');\n            }\n            \n            // Store reference to update on resize\n            path.dataset.x1 = x1; path.dataset.y1 = y1;\n            path.dataset.x2 = x2; path.dataset.y2 = y2;\n            path.dataset.cp1x = cp1x; path.dataset.cp1y = cp1y;\n            path.dataset.cp2x = cp2x; path.dataset.cp2y = cp2y;\n            \n            svgLayer.appendChild(path);\n        }\n\n        // 2. Tooltip Logic\n        nodes.forEach(node => {\n            const el = document.getElementById(node.id);\n            if (!el) return;\n\n            el.addEventListener('mouseenter', (e) => {\n                const rect = el.getBoundingClientRect();\n                tooltip.style.opacity = 1;\n                tooltip.style.left = (rect.right + 20) + 'px';\n                tooltip.style.top = rect.top + 'px';\n                \n                document.getElementById('ttTitle').innerText = node.label;\n                document.getElementById('ttDesc').innerText = node.desc;\n                document.getElementById('ttDetails').innerText = node.details;\n                \n                // Highlight connector\n                const next = el.nextElementSibling;\n                if (next && next.classList.contains('pipeline-node')) {\n                    const lines = svgLayer.querySelectorAll('path');\n                    lines.forEach(line => {\n                        line.style.opacity = '0.3';\n                    });\n                }\n            });\n\n            el.addEventListener('mouseleave', () => {\n                tooltip.style.opacity = 0;\n                svgLayer.querySelectorAll('path').forEach(line => line.style.opacity = '1');\n            });\n\n            el.addEventListener('mousemove', (e) => {\n                tooltip.style.left = (e.clientX + 15) + 'px';\n                tooltip.style.top = (e.clientY - 20) + 'px';\n            });\n        });\n\n        // 3. Simulate Pipeline Execution & Error Handling\n        function simulatePipeline() {\n            const logCount = document.getElementById('logCount');\n            const statusIndicator = document.getElementById('globalStatus');\n            \n            let step = 0;\n            const steps = [\n                { msg: \"Pipeline execution initiated...\", type: \"log-info\" },\n                { msg: \"Connecting to Snowflake Source...\", type: \"log-info\" },\n                { msg: \"Source table locked (Snapshot: 2.4M rows fetched).\", type: \"log-success\" },\n                { msg: \"Starting Staging Transformation...\", type: \"log-info\" },\n                { msg: \"Warning: Found 1,204 rows with NULL user_id. Flagging for quarantine.\", type: \"log-warn\" },\n                { msg: \"Staging validated. 99.92% data integrity score.\", type: \"log-success\" },\n                { msg: \"Incremental Check: Last run was 2023-10-27 14:00:00.\", type: \"log-info\" },\n                { msg: \"Processing 45,200 new events...\", type: \"log-info\" },\n                { \n                    msg: \"ERROR: Duplicate key violation in 'intm_user_sessions'. Session ID: sess_99821 found twice.\", \n                    type: \"log-error\",\n                    action: () => {\n                        // Trigger Error State\n                        const errorNode = document.getElementById('node-error');\n                        const stagingNode = document.getElementById('node-staging');\n                        \n                        errorNode.style.display = 'block';\n                        errorNode.style.animation = 'fadeIn 0.5s ease';\n                        \n                        // Highlight Error Line\n                        const lines = svgLayer.querySelectorAll('path');\n                        lines.forEach(line => {\n                            // Find the line going to error node (approximate check based on coordinates or logic)\n                            // For this demo, we know the last line added is the error line\n                            line.style.opacity = '0.3';\n                        });\n                        \n                        // Make error node glow\n                        errorNode.style.boxShadow = \"0 8px 24px rgba(255, 91, 91, 0.3)\";\n                        errorNode.style.borderColor = \"var(--accent-red)\";\n                        statusIndicator.style.backgroundColor = \"var(--accent-red)\";\n                        statusIndicator.style.boxShadow = \"0 0 8px var(--accent-red)\";\n                        statusIndicator.style.animation = \"none\"; // Stop pulsing for error\n                    }\n                },\n                { msg: \"Rolling back transaction to savepoint.\", type: \"log-warn\" },\n                { msg: \"Switching to Error Handling Mode...\", type: \"log-info\" },\n                { msg: \"1,204 problematic rows moved to 'retry_queue' table.\", type: \"log-success\" },\n                { \n                    msg: \"Resuming Main Pipeline (Incremental Load)...\", \n                    type: \"log-info\",\n                    action: () => {\n                        // Resume Success\n                        statusIndicator.style.backgroundColor = \"var(--accent-green)\";\n                        statusIndicator.style.boxShadow = \"0 0 8px var(--accent-green)\";\n                        statusIndicator.style.animation = \"pulse 2s infinite\";\n                        \n                        // Animate the BI Node\n                        const biNode = document.getElementById('node-bi');\n                        biNode.style.borderColor = \"var(--accent-teal)\";\n                        setTimeout(() => biNode.style.borderColor = \"var(--border-color)\", 1000);\n                    }\n                },\n                { msg: \"BI Model 'fct_daily_analytics' updated successfully.\", type: \"log-success\" },\n                { msg: \"Notification sent to Slack #data-alerts.\", type: \"log-success\" }\n            ];\n\n            function runNext() {\n                if (step >= steps.length) return;\n                \n                const logEntry = document.createElement('div');\n                logEntry.className = `log-entry ${steps[step].type}`;\n                \n                const time = new Date();\n                const timeStr = time.toLocaleTimeString('en-US', { hour12: false });\n                logEntry.innerHTML = `[${timeStr}] ${steps[step].msg}`;\n                \n                logStream.appendChild(logEntry);\n                logStream.scrollTop = logStream.scrollHeight;\n                logCount.innerText = `${step + 1} entries`;\n\n                if (steps[step].action) {\n                    steps[step].action();\n                }\n\n                step++;\n                // Randomize delay slightly for realism\n                const delay = Math.random() * 800 + 600;\n                setTimeout(runNext, delay);\n            }\n\n            setTimeout(runNext, 1000);\n        }\n\n        // 4. Handle Resize for SVG Lines\n        window.addEventListener('resize', () => {\n            // Clear existing lines\n            const paths = Array.from(svgLayer.querySelectorAll('path'));\n            paths.forEach(p => p.remove());\n\n            // Redraw\n            const source = document.getElementById('node-source');\n            const staging = document.getElementById('node-staging');\n            const intermediate = document.getElementById('node-intermediate');\n            const bi = document.getElementById('node-bi');\n            const error = document.getElementById('node-error');\n\n            drawLine(source, staging);\n            drawLine(staging, intermediate);\n            drawLine(intermediate, bi);\n            drawLine(staging, error, 'rgba(255, 91, 91, 0.3)'); // Error line\n        });\n\n        // Initialize\n        drawConnectors();\n        simulatePipeline();\n    });\n</script>\n</body>\n</html>", "ms": 67719, "pinned": false}